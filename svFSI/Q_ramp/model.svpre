number_of_variables 5  #P, Vx, Vy, Vz

mesh_and_adjncy_vtu mesh-complete/mesh-complete.mesh.vtu 
set_surface_id_vtp mesh-complete/mesh-surfaces/wall.vtp 1
set_surface_id_vtp mesh-complete/mesh-surfaces/inlet.vtp 2
set_surface_id_vtp mesh-complete/mesh-surfaces/outlet_aor.vtp 3
set_surface_id_vtp mesh-complete/mesh-surfaces/outlet_cor.vtp 4

fluid_density 1.06
fluid_viscosity 0.04
initial_pressure 0
initial_velocity 0.0001 0.0001 0.0001

prescribed_velocities_vtp mesh-complete/mesh-surfaces/inlet.vtp  # inlet velocity
pressure_vtp mesh-complete/mesh-surfaces/outlet_aor.vtp 0.0 #outlet pressure
pressure_vtp mesh-complete/mesh-surfaces/outlet_cor.vtp 0.0 #outlet pressure
noslip_vtp mesh-complete/mesh-surfaces/wall.vtp #no-slip

bct_analytical_shape parabolic
bct_period 1.0
bct_point_number 2 #steady_flow file points num
bct_fourier_mode_number 15

bct_create mesh-complete/mesh-surfaces/inlet.vtp inflow.flow

bct_merge_on

bct_write_dat bct.dat
bct_write_vtp bct.vtp

write_geombc geombc.dat.1
write_restart restart.0.1
write_numstart 0
