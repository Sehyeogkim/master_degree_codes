"""fable4 cross_freeze 규칙 verify HTML — 실제 종목에 L_line/S_line·플립 지점을 캔들 위에 표시.
사용: python3 verify_fable4.py → report/verify_fable4_cross_freeze.html"""
import os, sys, json, html, importlib.util

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(ROOT, "pipeline"))
from data_source import load_bars_csv

spec = importlib.util.spec_from_file_location("_f4", os.path.join(ROOT, "engines", "engine_fable4", "engine_fable4.py"))
f4 = importlib.util.module_from_spec(spec); sys.modules["_f4"] = f4; spec.loader.exec_module(f4)

OUT = os.path.join(ROOT, "report", "verify_fable4_cross_freeze.html")
BARS = os.path.join(ROOT, "report", "live", "live_project1", "2026-07-06", "bars")
TOP = {r["code"]: r for r in json.load(open(os.path.join(ROOT, "report", "live", "live_project1", "2026-07-06", "_top5.json")))}

PAPER, INK, ACC, GRID = "#F0EEE6", "#211D18", "#CC785C", "#D9D3C7"
MUTE, CARD = "#6B5E54", "#FBFAF6"
UP, DOWN, LONGC, SHORTC = "#D24B4B", "#3A6EA5", "#2E7D32", "#C2493C"
esc = html.escape

# 파라미터: 밴드 바운스 확인용 — 무제한 플립·월요일 종일
CFG = dict(tp_gate=0.10, entries=("trail",), stop_mode="none", fee=0.00015, slip=0.0005, tax=0.0015,
           round_shares=True, flip_monday=True, flip_days=1, flip_cutoff_hm=None, flip_max=9,
           flip_mode="cross_freeze")


def classify_lines(bars, F0):
    base, case, longL, shortL, ini = f4.classify(bars[0], F0)
    return max(longL), min(shortL), case


def chart(code, sel):
    bars = load_bars_csv(os.path.join(BARS, f"{code}_5m.csv"))
    F0 = sel["fri_close"]; name = sel.get("name", code)
    L0, S0, case = classify_lines(bars, F0)
    ev, ctx = f4.run(bars, F0, capital=10_000_000.0, **CFG)
    # 창을 09:05~11:00 구간만 크게 (플립은 월요일 오전에 몰림) — 전체도 스크롤
    n = len(bars); cw = 3.0
    W = round(n * cw); padT, padB, padL, padR = 30, 40, 8, 8
    H = 340; plotH = H - padT - padB
    lo = min(min(b.l for b in bars), F0, S0); hi = max(max(b.h for b in bars), F0, L0)
    span = hi - lo; lo -= span * .05; hi += span * .05; span = hi - lo
    Y = lambda p: padT + plotH * (hi - p) / span
    X = lambda i: padL + i * cw + cw / 2
    el = [f'<svg viewBox="0 0 {W+padL+padR} {H}" width="{W+padL+padR}" height="{H}" font-family="ui-sans-serif,system-ui,sans-serif">']
    el.append(f'<rect width="{W+padL+padR}" height="{H}" fill="{CARD}"/>')
    # 일 구분
    days = ["월", "화", "수", "목", "금"]; prev = None; di = 0
    for i, b in enumerate(bars):
        d = b.dt[:10]
        if d != prev:
            if prev is not None:
                el.append(f'<line x1="{X(i)-cw/2:.1f}" y1="{padT}" x2="{X(i)-cw/2:.1f}" y2="{padT+plotH}" stroke="{GRID}" stroke-width="1"/>')
            el.append(f'<text x="{X(i)+2:.1f}" y="{padT+11:.0f}" font-size="10" fill="{MUTE}" font-weight="700">{days[di] if di<5 else d[5:]}</text>')
            prev = d; di += 1
    # 기준선: F0, 초기 롱선(L0), 초기 숏선(S0), 고정선(L_line/S_line)
    for val, col, txt, dash in [(F0, MUTE, f"F0 {F0:,.0f}", "2 3"),
                                 (L0, LONGC, f"초기 롱선 {L0:,.0f}", "5 3"),
                                 (S0, SHORTC, f"초기 숏선 {S0:,.0f}", "5 3")]:
        yy = Y(val)
        el.append(f'<line x1="{padL}" y1="{yy:.1f}" x2="{padL+W}" y2="{yy:.1f}" stroke="{col}" stroke-width="1" stroke-dasharray="{dash}" opacity="0.5"/>')
        el.append(f'<text x="{padL+2}" y="{yy-3:.1f}" font-size="9.5" fill="{col}">{txt}</text>')
    # 고정선 (실선, 진하게)
    if abs(ctx["L_line"] - L0) > 1e-9:
        yy = Y(ctx["L_line"]); el.append(f'<line x1="{padL}" y1="{yy:.1f}" x2="{padL+W}" y2="{yy:.1f}" stroke="{LONGC}" stroke-width="1.6"/><text x="{padL+W-4}" y="{yy-3:.1f}" font-size="9.5" fill="{LONGC}" text-anchor="end">고정 롱선 {ctx["L_line"]:,.0f}</text>')
    if abs(ctx["S_line"] - S0) > 1e-9:
        yy = Y(ctx["S_line"]); el.append(f'<line x1="{padL}" y1="{yy:.1f}" x2="{padL+W}" y2="{yy:.1f}" stroke="{SHORTC}" stroke-width="1.6"/><text x="{padL+W-4}" y="{yy-3:.1f}" font-size="9.5" fill="{SHORTC}" text-anchor="end">고정 숏선 {ctx["S_line"]:,.0f}</text>')
    # 캔들
    bw = max(1.6, cw * 0.6)
    for i, b in enumerate(bars):
        up = b.c >= b.o; col = UP if up else DOWN; cx = X(i)
        el.append(f'<line x1="{cx:.1f}" y1="{Y(b.h):.1f}" x2="{cx:.1f}" y2="{Y(b.l):.1f}" stroke="{col}" stroke-width="0.8"/>')
        yo, yc = Y(b.o), Y(b.c); top = min(yo, yc)
        el.append(f'<rect x="{cx-bw/2:.1f}" y="{top:.1f}" width="{bw:.1f}" height="{max(0.8,abs(yc-yo)):.1f}" fill="{col}"/>')
    # 이벤트
    for e in ev:
        cx = X(e.idx); y = Y(e.price)
        if e.kind == "ENTRY":
            flip = "리버설" in e.reason
            c = ACC if flip else INK
            el.append(f'<circle cx="{cx:.1f}" cy="{y:.1f}" r="5" fill="{"#fff" if not flip else ACC}" stroke="{c}" stroke-width="1.8"/>')
            el.append(f'<text x="{cx:.1f}" y="{y-8:.1f}" font-size="9.5" font-weight="700" fill="{c}" text-anchor="middle">{"FLIP→"+("롱" if e.direction>0 else "숏") if flip else ("롱" if e.direction>0 else "숏")}</text>')
        else:
            el.append(f'<circle cx="{cx:.1f}" cy="{y:.1f}" r="3.5" fill="{INK}"/>')
    el.append('</svg>')
    evlog = "".join(
        f'<li><b>{e.dt[11:16]}</b> {("진입" if e.kind=="ENTRY" else "청산")} {"롱" if e.direction>0 else "숏"} @{e.price:,.0f} <span style="color:{MUTE}">— {esc(e.reason)}</span></li>'
        for e in ev)
    return f"""<div class="stock">
<div class="sh"><b class="nm">{esc(name)} ({code})</b>
<span class="meta">Case{case} · 플립 {ctx['flips_used']}회 · 주간 <b style="color:{LONGC if ctx['weekly_return']>=0 else SHORTC}">{ctx['weekly_return']*100:+.2f}%</b></span></div>
<div class="scroll">{"".join(el)}</div>
<details><summary>이벤트 로그 ({len(ev)}건) · 고정선 L={ctx['L_line']:,.0f} S={ctx['S_line']:,.0f}</summary><ul>{evlog}</ul></details>
</div>"""


def build():
    blocks = "".join(chart(c, s) for c, s in TOP.items())
    return f"""<!DOCTYPE html><html lang="ko"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>verify · fable4 cross_freeze</title>
<style>
*{{box-sizing:border-box}} body{{margin:0;background:{PAPER};color:{INK};font-family:ui-sans-serif,system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.6}}
.wrap{{max-width:1040px;margin:0 auto;padding:34px 20px 70px}}
h1{{font-size:24px;margin:0 0 6px;font-weight:800}}
.sub{{color:{MUTE};font-size:13.5px;margin:0 0 18px}}
.rule{{background:{CARD};border-left:4px solid {ACC};border-radius:0 10px 10px 0;padding:14px 18px;margin:14px 0;font-size:14px}}
.rule b{{color:{INK}}}
.stock{{background:{CARD};border:1px solid {GRID};border-radius:12px;padding:14px 16px;margin:14px 0}}
.sh{{display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;align-items:baseline}}
.nm{{font-size:15px}} .meta{{font-size:12.5px;color:{MUTE};font-variant-numeric:tabular-nums}}
.scroll{{overflow-x:auto;margin:8px 0;border:1px solid {GRID};border-radius:8px}}
details{{font-size:12.5px}} summary{{cursor:pointer;color:{MUTE}}} ul{{margin:6px 0;padding-left:18px}} li{{margin:2px 0}}
.legend{{font-size:12px;color:{MUTE};margin-top:6px}}
</style></head><body><div class="wrap">
<h1>규칙 확인 · fable4 리버설 밴드 (cross_freeze)</h1>
<p class="sub">이 규칙을 엔진에 넣기 전, 실제 종목(7/6 주)에 어떻게 찍히는지 눈으로 확인하는 문서.</p>
<div class="rule">
<b>규칙</b> ① 롱/숏 진입선을 각 방향 <b>첫 체결가에 고정</b>(초기값=첫봉 기준선). ②
보유 중 종가가 <b>반대편 고정선을 단순 돌파</b>하면 전환(트레일링 조건 없음). ③ 이후 재플립에도 고정선 불변.
④ 최초 진입은 281 트레일링 유지. <b>여기선 확인용으로 플립 무제한·월요일 종일</b>로 그림.
</div>
<p class="legend">캔들 상승 <span style="color:{UP}">적</span>/하락 <span style="color:{DOWN}">청</span> ·
<span style="color:{LONGC}">초록</span>=롱선(점선 초기→실선 고정) · <span style="color:{SHORTC}">빨강</span>=숏선 ·
◯ 최초진입 · <span style="color:{ACC};font-weight:700">주황 FLIP</span>=전환 · ● 청산 · 점선 F0. 가로 스크롤.</p>
{blocks}
<p class="legend" style="margin-top:20px">이 규칙이 네 의도랑 맞으면 → 다음은 flip_max × 창(요일·시각) 파라미터 스윕(부트스트랩+walk-forward).</p>
</div></body></html>"""


if __name__ == "__main__":
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    open(OUT, "w", encoding="utf-8").write(build())
    print("wrote", OUT)
