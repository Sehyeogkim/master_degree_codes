def candle_svg(ex):
    bars = ex["bars"]; n = len(bars)
    cw = 2.7
    W = round(n * cw); padT, padB, padL, padR = 34, 46, 8, 8
    H = 330; plotH = H - padT - padB
    lo = min(min(b["l"] for b in bars), ex["F0"], ex["short_gate"])
    hi = max(max(b["h"] for b in bars), ex["F0"], ex["long_gate"])
    span = hi - lo; pad = span * 0.06; lo -= pad; hi += pad; span = hi - lo
    Y = lambda p: padT + plotH * (hi - p) / span
    X = lambda i: padL + i * cw + cw / 2
    el = [f'<svg viewBox="0 0 {W+padL+padR} {H}" width="{W+padL+padR}" height="{H}" '
          f'font-family="ui-sans-serif,system-ui,sans-serif">']
    el.append(f'<rect x="0" y="0" width="{W+padL+padR}" height="{H}" fill="{CARD}"/>')

    # 일 구분선 + 요일 라벨
    days = ["월", "화", "수", "목", "금"]
    prev = None; di = 0
    for i, b in enumerate(bars):
        d = b["dt"][:10]
        if d != prev:
            if prev is not None:
                el.append(f'<line x1="{X(i)-cw/2:.1f}" y1="{padT}" x2="{X(i)-cw/2:.1f}" '
                          f'y2="{padT+plotH}" stroke="{GRID}" stroke-width="1"/>')
            lab = days[di] if di < len(days) else d[5:]
            el.append(f'<text x="{X(i)+2:.1f}" y="{padT+12:.0f}" font-size="10" '
                      f'fill="{MUTE}" font-weight="700">{lab}</text>')
            prev = d; di += 1

    # 기준선: F0, long_gate, short_gate
    for val, col, txt, dash in [
        (ex["F0"], MUTE, f'F0 {ex["F0"]:,.0f}', "2 3"),
        (ex["long_gate"], POS, f'롱 기준선', "5 3"),
        (ex["short_gate"], DOWN, f'숏 기준선', "5 3")]:
        yy = Y(val)
        el.append(f'<line x1="{padL}" y1="{yy:.1f}" x2="{padL+W}" y2="{yy:.1f}" '
                  f'stroke="{col}" stroke-width="1" stroke-dasharray="{dash}" opacity="0.55"/>')
        el.append(f'<text x="{padL+W-4}" y="{yy-3:.1f}" font-size="9.5" fill="{col}" '
                  f'text-anchor="end" opacity="0.9">{txt}</text>')

    # 캔들
    bw = max(1.4, cw * 0.62)
    for i, b in enumerate(bars):
        up = b["c"] >= b["o"]; col = UP if up else DOWN
        cx = X(i)
        el.append(f'<line x1="{cx:.1f}" y1="{Y(b["h"]):.1f}" x2="{cx:.1f}" y2="{Y(b["l"]):.1f}" '
                  f'stroke="{col}" stroke-width="0.8"/>')
        yo, yc = Y(b["o"]), Y(b["c"])
        top = min(yo, yc); hgt = max(0.8, abs(yc - yo))
        el.append(f'<rect x="{cx-bw/2:.1f}" y="{top:.1f}" width="{bw:.1f}" height="{hgt:.1f}" '
                  f'fill="{col}"/>')

    # 이벤트 마커
    def find_flip(evfab):
        ent = [e for e in evfab if e["kind"] == "ENTRY"]
        return ent[0], (ent[1] if len(ent) > 1 else None), \
               [e for e in evfab if e["kind"] == "EXIT"]
    e0, eflip, exits = find_flip(ex["evfab"])

    # 진입 E (원포지션)
    ei = e0["idx"]; ey = Y(e0["price"])
    el.append(f'<circle cx="{X(ei):.1f}" cy="{ey:.1f}" r="4.5" fill="none" stroke="{INK}" stroke-width="1.6"/>')
    el.append(f'<text x="{X(ei):.1f}" y="{ey-9:.1f}" font-size="10" fill="{INK}" '
              f'text-anchor="middle" font-weight="700">E</text>')

    # 플립 수직선 + 라벨
    if eflip:
        fx = X(eflip["idx"])
        el.append(f'<line x1="{fx:.1f}" y1="{padT}" x2="{fx:.1f}" y2="{padT+plotH}" '
                  f'stroke="{ACCENT}" stroke-width="1.6" stroke-dasharray="3 2"/>')
        fdir = "숏" if eflip["dir"] < 0 else "롱"
        el.append(f'<rect x="{fx+3:.1f}" y="{padT+16:.0f}" width="86" height="16" rx="3" '
                  f'fill="{ACCENT}"/>')
        el.append(f'<text x="{fx+7:.1f}" y="{padT+27:.0f}" font-size="9.5" fill="#fff" '
                  f'font-weight="700">FLIP → {fdir} 전환</text>')
        fy = Y(eflip["price"])
        el.append(f'<circle cx="{fx:.1f}" cy="{fy:.1f}" r="4.5" fill="{ACCENT}" stroke="#fff" stroke-width="1.2"/>')

    # 강제청산(마지막) 마커
    last = exits[-1]; lx = X(last["idx"]); ly = Y(last["price"])
    el.append(f'<circle cx="{lx:.1f}" cy="{ly:.1f}" r="4" fill="{INK}"/>')
    el.append(f'<text x="{lx:.1f}" y="{ly-9:.1f}" font-size="9.5" fill="{INK}" '
              f'text-anchor="end" font-weight="700">청산 {last["price"]:,.0f}</text>')
    el.append('</svg>')
    return "".join(el), W + padL + padR


def pct(x): return f'{x*100:+.1f}%'


