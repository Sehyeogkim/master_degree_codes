    m0 = sum(s["r"] for w in w281 for s in w281[w]) / sum(len(w281[w]) for w in w281) * 100
    m1, f1 = _sw_stats(w281, w1)
    m3, f3 = _sw_stats(w281, w3)
    m2, f2 = _sw_stats(w281, w2)

    best0 = max((k for k in r281 if r281[k][2]), key=lambda k: r281[k][1]["obs_mean"])
    b0 = r281[best0][1]
    cards = "".join(example_card(e) for e in ex)
    rows = rule_rows(r281, r1, r3, r2)

    return f"""<title>281 vs 리버설(v1·v3·v2) — 왜 더 낮은가</title>
