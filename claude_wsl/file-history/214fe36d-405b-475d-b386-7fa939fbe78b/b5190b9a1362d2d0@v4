def rule_rows(r281, r1, r3, r2):
    rows = []
    for key, label, fn in allocation.RULES:
        l0, s0, causal = r281[key]; _, s1, _ = r1[key]; _, s3, _ = r3[key]; _, s2, _ = r2[key]
        d = s2["obs_mean"] - s0["obs_mean"]        # v2(최대확장) vs 281
        w = min(100, abs(d) / 0.60 * 100)
        bar = (f'<span class="barwrap"><span class="bar0"></span>'
               f'<span class="barneg" style="width:{w:.0f}%"></span></span>' if d < 0 else
               f'<span class="barwrap"><span class="bar0"></span>'
               f'<span class="barpos" style="width:{w:.0f}%"></span></span>')
        badge = "" if causal else ' <span class="look">look-ahead</span>'
        rows.append(
            f'<tr{"" if causal else " class=dim"}>'
            f'<td><b>{esc(key)}</b>{badge}<div class="sub">{esc(l0)}</div></td>'
            f'<td class="num">{s0["obs_mean"]:+.2f}%</td>'
            f'<td class="num">{s1["obs_mean"]:+.2f}%</td>'
            f'<td class="num">{s3["obs_mean"]:+.2f}%</td>'
            f'<td class="num">{s2["obs_mean"]:+.2f}%</td>'
            f'<td class="num dcell {"pos" if d>0 else "neg"}">{d:+.2f}%p</td>'
            f'<td class="barcell">{bar}</td></tr>')
    return "".join(rows)


def _sw_stats(base_weeks, var_weeks):
    """종목-주 평균 net(%)와 baseline 대비 플립영향 비율(%)."""
    A = {(w, s["code"]): s for w in base_weeks for s in base_weeks[w]}
    Bm = {(w, s["code"]): s for w in var_weeks for s in var_weeks[w]}
    keys = [k for k in A if k in Bm]
    mean = sum(Bm[k]["r"] for k in keys) / len(keys) * 100
    changed = sum(1 for k in keys if abs(A[k]["r"] - Bm[k]["r"]) > 1e-12)
    return mean, changed / len(keys) * 100


