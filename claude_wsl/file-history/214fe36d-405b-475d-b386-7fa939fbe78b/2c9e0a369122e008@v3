사용: python3 make_wf_report.py → report/backtest_walkforward_oos.artifact.html"""
import os, json, html

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
OUT = os.path.join(ROOT, "report", "backtest_walkforward_oos.artifact.html")

PAPER, INK, ACCENT, GRID = "#F0EEE6", "#211D18", "#CC785C", "#D9D3C7"
MUTE, CARD = "#6B5E54", "#FBFAF6"
POS, NEG = "#2E7D32", "#C25744"
esc = html.escape

R = json.load(open(os.path.join(HERE, "wf_results.json"), encoding="utf-8"))
S = R["summary"]


def fold_chart():
    """fold별 test 평균: WF-선택 vs 281 (같은 주)."""
    folds = R["folds"]
    # fold 경계로 281 fold 평균 계산
    b281 = []
    pos_ = 0
    for f in folds:
        seg = R["oos_281"][pos_:pos_ + f["test_n"]]
        b281.append(sum(seg) / len(seg) * 100)
        pos_ += f["test_n"]
    W, H, padL, padT, padB = 860, 260, 52, 20, 58
    pw, ph = W - padL - 20, H - padT - padB
    vals = [f["test_mean"] for f in folds] + b281 + [0.0]
    lo, hi = min(vals) - 0.5, max(vals) + 0.7
    n = len(folds)
    slot = pw / n
    bw = min(34, slot * 0.28)
    Y = lambda v: padT + ph * (hi - v) / (hi - lo)
    el = [f'<svg viewBox="0 0 {W} {H}" width="100%" style="max-width:{W}px" font-family="ui-sans-serif,system-ui,sans-serif">']
    for tv in (-1, 0, 1, 2, 3, 4):
        if lo <= tv <= hi:
            col = INK if tv == 0 else GRID
            el.append(f'<line x1="{padL}" y1="{Y(tv):.0f}" x2="{W-20}" y2="{Y(tv):.0f}" stroke="{col}" stroke-width="{1.3 if tv==0 else 1}"/>')
            el.append(f'<text x="{padL-6}" y="{Y(tv)+3:.0f}" font-size="10" fill="{MUTE}" text-anchor="end">{tv:+d}%</text>')
    for i, f in enumerate(folds):
        cx = padL + slot * (i + 0.5)
        for k, (v, col, name) in enumerate([(f["test_mean"], ACCENT, "WF-선택"), (b281[i], MUTE, "281")]):
            x = cx - bw - 2 + k * (bw + 4)
            y0, y1 = Y(max(0, v)), Y(min(0, v))
            tip = f'F{f["fold"]} {name}: {v:+.2f}%/주 · test {f["test_from"]}~{f["test_to"]}'
            el.append(f'<g><title>{esc(tip)}</title>'
                      f'<rect x="{x:.0f}" y="{y0:.0f}" width="{bw:.0f}" height="{max(1.5, y1-y0):.0f}" rx="3" fill="{col}" fill-opacity="{0.9 if k==0 else 0.45}"/></g>')
            if k == 0:
                el.append(f'<text x="{x+bw/2:.0f}" y="{y0-5 if v>=0 else y1+12:.0f}" font-size="9.5" font-weight="700" fill="{INK}" text-anchor="middle">{v:+.1f}</text>')
        el.append(f'<text x="{cx:.0f}" y="{H-38}" font-size="10.5" font-weight="700" fill="{INK}" text-anchor="middle">F{f["fold"]}</text>')
        el.append(f'<text x="{cx:.0f}" y="{H-25}" font-size="8.5" fill="{MUTE}" text-anchor="middle">{f["test_from"][2:7]}~</text>')
        el.append(f'<text x="{cx:.0f}" y="{H-14}" font-size="8.5" fill="{MUTE}" text-anchor="middle">{esc(f["selected"].replace("d1~","").replace("x1",""))}</text>')
    el.append(f'<rect x="{W-206}" y="{padT}" width="10" height="10" fill="{ACCENT}" fill-opacity="0.9" rx="2"/><text x="{W-192}" y="{padT+9}" font-size="10" fill="{INK}">WF-선택 (train만 보고 선택)</text>')
    el.append(f'<rect x="{W-206}" y="{padT+16}" width="10" height="10" fill="{MUTE}" fill-opacity="0.45" rx="2"/><text x="{W-192}" y="{padT+25}" font-size="10" fill="{INK}">281 기준</text>')
    el.append('</svg>')
    return "".join(el)


def delta_chart():
    """OOS Δ vs 281 — 깨끗한 WF 3종(동시/게이트만/플립만) + 낙관 참고 1종. CI whisker."""
    rows = [
        ("WF 게이트만 선택 (깨끗)", S["wf_gate_vs_281"], True),
        ("WF 동시 선택 (깨끗)", S["wf_vs_281"], True),
        ("WF 플립만 선택 (깨끗)", S["wf_flip_vs_281"], True),
        ("고정스택 둘다 (참고·낙관)", S["fix_vs_281"], False),
    ]
    W, rowh, labW = 800, 34, 250
    pw = W - labW - 70
    lo = min(min(r[1]["lo"] for r in rows), 0) - 0.1
    hi = max(max(r[1]["hi"] for r in rows), 0) + 0.1
    H = len(rows) * rowh + 40
    X = lambda v: labW + pw * (v - lo) / (hi - lo)
    el = [f'<svg viewBox="0 0 {W} {H}" width="100%" style="max-width:{W}px" font-family="ui-sans-serif,system-ui,sans-serif">']
    el.append(f'<line x1="{X(0):.0f}" y1="10" x2="{X(0):.0f}" y2="{H-26}" stroke="{INK}" stroke-width="1.3"/>')
    for tv in (-0.5, 0.5, 1.0):
        if lo <= tv <= hi:
            el.append(f'<line x1="{X(tv):.0f}" y1="10" x2="{X(tv):.0f}" y2="{H-26}" stroke="{GRID}" stroke-width="1"/>')
            el.append(f'<text x="{X(tv):.0f}" y="{H-12}" font-size="10" fill="{MUTE}" text-anchor="middle">{tv:+.1f}%p</text>')
    el.append(f'<text x="{X(0):.0f}" y="{H-12}" font-size="10" fill="{INK}" text-anchor="middle" font-weight="700">0</text>')
    for i, (name, d, clean) in enumerate(rows):
        y = 26 + i * rowh
        col = (POS if d["delta"] > 0 else NEG) if clean else MUTE
        op = 1.0 if clean else 0.75
        el.append(f'<text x="{labW-10}" y="{y+4}" font-size="11.5" font-weight="{800 if clean else 500}" fill="{INK}" text-anchor="end">{esc(name)}</text>')
        tip = f'{name}: Δ{d["delta"]:+.3f}%p · 95% CI [{d["lo"]:+.3f}, {d["hi"]:+.3f}] · P(Δ>0)={d["p_pos"]*100:.0f}%'
        el.append(f'<g opacity="{op}"><title>{esc(tip)}</title>')
        el.append(f'<line x1="{X(d["lo"]):.0f}" y1="{y}" x2="{X(d["hi"]):.0f}" y2="{y}" stroke="{col}" stroke-width="2"/>')
        for cx in (d["lo"], d["hi"]):
            el.append(f'<line x1="{X(cx):.0f}" y1="{y-5}" x2="{X(cx):.0f}" y2="{y+5}" stroke="{col}" stroke-width="2"/>')
        el.append(f'<circle cx="{X(d["delta"]):.0f}" cy="{y}" r="5.5" fill="{col}" stroke="{CARD}" stroke-width="1.6"/>')
        el.append(f'<text x="{X(d["hi"])+8:.0f}" y="{y+4}" font-size="10.5" font-weight="700" fill="{INK}">{d["delta"]:+.2f}%p · P={d["p_pos"]*100:.0f}%</text>')
        el.append('</g>')
    el.append('</svg>')
    return "".join(el)


def fold_rows():
    out = []
    for f in R["folds"]:
        col = "pos" if f["test_mean"] > 0 else "neg"
        out.append(f'<tr><td><b>F{f["fold"]}</b></td><td class="num">{f["train_n"]}주</td>'
                   f'<td><b>{esc(f["selected"])}</b></td>'
                   f'<td class="num">{f["train_mean"]:+.2f}%</td>'
                   f'<td class="num sub">{esc(f["test_from"])} ~ {esc(f["test_to"])} ({f["test_n"]}주)</td>'
                   f'<td class="num {col}"><b>{f["test_mean"]:+.2f}%</b></td></tr>')
    return "".join(out)


def build():
    wf, b281 = S["wf"], S["b281"]
    d = S["wf_vs_281"]
    bias = S["fix"]["mean"] - wf["mean"]
    gates = [f["selected"].split("·")[-1] for f in R["folds"]]
    gate_stable = len(set(gates)) == 1

    return f"""<title>walk-forward OOS — 스택 검증 판정</title>
