    msg["Subject"] = subject
    msg.set_content("HTML 지원 클라이언트에서 보세요. 상세는 첨부 MD/HTML.")
    msg.add_alternative(BODY, subtype="html")
    with open(MD, "rb") as f:
        msg.add_attachment(f.read(), maintype="text", subtype="markdown",
                           filename="fable_실험총정리_2026-07-19.md")
    for src, name in HTMLS:
        with open(os.path.join(ROOT, "report", src), encoding="utf-8") as f:
            msg.add_attachment(_standalone(f.read()), maintype="text", subtype="html",
                               filename=name)

    if a.dry_run:
        print(f"[dry-run] → {to}\n제목: {subject}\n첨부: MD + {len(HTMLS)} HTML")
        return
    sender, password = _load_creds()
    msg["From"] = sender
    ctx = ssl.create_default_context()
    with smtplib.SMTP_SSL("smtp.gmail.com", 465, context=ctx) as s:
        s.login(sender, password)
        s.send_message(msg)
    print(f"전송 완료 → {', '.join(to)} | {subject}")


if __name__ == "__main__":
    main()
