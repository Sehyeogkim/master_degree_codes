def _standalone(body_only_html: str) -> bytes:
    """body-only 아티팩트 HTML → 완전한 standalone 문서 (charset·doctype 포함)."""
    m = re.search(r"<title>(.*?)</title>", body_only_html, re.S)
    title = m.group(1) if m else "bullet281 report"
    rest = body_only_html.replace(m.group(0), "", 1) if m else body_only_html
    return (f'<!DOCTYPE html>\n<html lang="ko"><head><meta charset="utf-8">\n'
            f'<meta name="viewport" content="width=device-width,initial-scale=1">\n'
            f'<title>{title}</title></head>\n<body style="margin:0">\n{rest}\n</body></html>'
            ).encode("utf-8")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--to", help="수신자 override(쉼표)")
