def curve_svg():
    """θ별 인샘플 square 주간평균 — 단봉 곡선(θ3 정점)."""
    c = ST["insample"]["curve"]
    base = c["0"] if "0" in c else c[0]
    xs = sorted(int(k) for k in c)
    W, H, padL, padT, padB = 560, 240, 46, 24, 42
    pw, ph = W - padL - 20, H - padT - padB
    vals = [c[str(x)] for x in xs]
    lo, hi = 0, max(vals) + 0.4
    X = lambda i: padL + pw * i / (len(xs) - 1)
    Y = lambda v: padT + ph * (hi - v) / (hi - lo)
    el = [f'<svg viewBox="0 0 {W} {H}" width="100%" style="max-width:{W}px" font-family="ui-sans-serif,system-ui,sans-serif">']
    for tv in (0, 1, 2):
        el.append(f'<line x1="{padL}" y1="{Y(tv):.0f}" x2="{W-20}" y2="{Y(tv):.0f}" stroke="{GRID}" stroke-width="1"/>')
        el.append(f'<text x="{padL-6}" y="{Y(tv)+3:.0f}" font-size="10" fill="{MUTE}" text-anchor="end">{tv}%</text>')
    el.append(f'<line x1="{padL}" y1="{Y(base):.0f}" x2="{W-20}" y2="{Y(base):.0f}" stroke="{REF}" stroke-width="1.4" stroke-dasharray="5 3"/>')
    el.append(f'<text x="{W-22}" y="{Y(base)-5:.0f}" font-size="10" fill="{MUTE}" text-anchor="end">필터 없음 {base:.2f}%</text>')
    path = " ".join(f'{"M" if i==0 else "L"} {X(i):.0f} {Y(c[str(x)]):.0f}' for i, x in enumerate(xs))
    el.append(f'<path d="{path}" fill="none" stroke="{WIN}" stroke-width="2.4"/>')
    peak = max(range(len(xs)), key=lambda i: c[str(xs[i])])
    for i, x in enumerate(xs):
        v = c[str(x)]; r = 6 if i == peak else 4
        el.append(f'<g><title>갭 임계 {x}% · 주평균 {v:.2f}%</title>'
                  f'<circle cx="{X(i):.0f}" cy="{Y(v):.0f}" r="{r}" fill="{WIN}" stroke="{CARD}" stroke-width="2"/></g>')
        if i in (0, peak, len(xs) - 1):
            el.append(f'<text x="{X(i):.0f}" y="{Y(v)-11:.0f}" font-size="11" font-weight="700" fill="{INK}" text-anchor="middle">{v:.2f}%</text>')
        el.append(f'<text x="{X(i):.0f}" y="{H-24}" font-size="10.5" fill="{MUTE}" text-anchor="middle">±{x}%</text>')
    el.append(f'<text x="{padL+pw/2:.0f}" y="{H-6}" font-size="10.5" fill="{MUTE}" text-anchor="middle">갭 임계값 (월 시가가 F0에서 몇 % 이상 튀어야 참가)</text>')
    el.append('</svg>')
    return "".join(el)


def compare_svg():
    """무필터 vs 갭필터 — 인샘플·OOS 2쌍 그룹 바. 갭필터=초록 강조, 무필터=회색 기준."""
    ins = ST["insample"]; wf = ST["wf"]
    groups = [("전체 5년\n(255주)", ins["base"], ins["t3"]),
              ("검증구간\n(OOS 152주)", wf["base"], wf["gap"])]
    W, H, padL, padT, padB = 520, 260, 46, 20, 54
    pw, ph = W - padL - 20, H - padT - padB
    hi = 3.2
    Y = lambda v: padT + ph * (hi - v) / hi
    el = [f'<svg viewBox="0 0 {W} {H}" width="100%" style="max-width:{W}px" font-family="ui-sans-serif,system-ui,sans-serif">']
    for tv in (0, 1, 2, 3):
        el.append(f'<line x1="{padL}" y1="{Y(tv):.0f}" x2="{W-20}" y2="{Y(tv):.0f}" stroke="{GRID}" stroke-width="1"/>')
        el.append(f'<text x="{padL-6}" y="{Y(tv)+3:.0f}" font-size="10" fill="{MUTE}" text-anchor="end">{tv}%</text>')
    gw = pw / len(groups); bw = 46
    for gi, (lab, b0, b1) in enumerate(groups):
        cx = padL + gw * (gi + 0.5)
        for k, (v, col, name) in enumerate([(b0, REF, "필터 없음"), (b1, WIN, "갭필터")]):
            x = cx - bw - 6 + k * (bw + 12)
            y = Y(max(v, 0))
            el.append(f'<g><title>{name} · {lab.replace(chr(10)," ")} · {v:.2f}%/주</title>'
                      f'<rect x="{x:.0f}" y="{y:.0f}" width="{bw}" height="{max(2,Y(0)-y):.0f}" rx="4" '
                      f'fill="{col}" fill-opacity="{0.55 if k==0 else 1}"/>'
                      f'<text x="{x+bw/2:.0f}" y="{y-6:.0f}" font-size="12" font-weight="800" fill="{INK}" text-anchor="middle">{v:.2f}</text></g>')
        for ln, dy in zip(lab.split("\n"), (0, 12)):
            el.append(f'<text x="{cx:.0f}" y="{H-30+dy:.0f}" font-size="11" fill="{MUTE}" text-anchor="middle">{ln}</text>')
    # 범례
    el.append(f'<rect x="{padL}" y="4" width="11" height="11" rx="2" fill="{REF}" fill-opacity="0.55"/><text x="{padL+16}" y="13" font-size="10.5" fill="{INK}">필터 없음(기존)</text>')
    el.append(f'<rect x="{padL+120}" y="4" width="11" height="11" rx="2" fill="{WIN}"/><text x="{padL+136}" y="13" font-size="10.5" fill="{INK}">갭필터</text>')
    el.append('</svg>')
    return "".join(el)


def fold_svg():
    """6개 검증구간(fold) 각각의 성적 — 전부 플러스임을 보임."""
    f = ST["wf"]["folds"]; th = ST["wf"]["theta"]
    W, H, padL, padT, padB = 520, 200, 40, 18, 40
    pw, ph = W - padL - 16, H - padT - padB
    hi = max(f) + 0.6
    Y = lambda v: padT + ph * (hi - v) / hi
    n = len(f); gw = pw / n; bw = min(40, gw * 0.6)
    el = [f'<svg viewBox="0 0 {W} {H}" width="100%" style="max-width:{W}px" font-family="ui-sans-serif,system-ui,sans-serif">']
    el.append(f'<line x1="{padL}" y1="{Y(0):.0f}" x2="{W-16}" y2="{Y(0):.0f}" stroke="{INK}" stroke-width="1.2"/>')
    for i, v in enumerate(f):
        cx = padL + gw * (i + 0.5); y = Y(max(v, 0))
        el.append(f'<g><title>검증기간 {i+1} (갭임계 ±{th[i]}%) · {v:.2f}%/주</title>'
                  f'<rect x="{cx-bw/2:.0f}" y="{y:.0f}" width="{bw:.0f}" height="{max(2,Y(0)-y):.0f}" rx="3" fill="{WIN}"/>'
                  f'<text x="{cx:.0f}" y="{y-6:.0f}" font-size="11" font-weight="700" fill="{INK}" text-anchor="middle">+{v:.1f}</text></g>')
        el.append(f'<text x="{cx:.0f}" y="{H-22}" font-size="10" fill="{MUTE}" text-anchor="middle">기간{i+1}</text>')
        el.append(f'<text x="{cx:.0f}" y="{H-9}" font-size="9" fill="{MUTE}" text-anchor="middle">±{th[i]}%</text>')
    el.append('</svg>')
    return "".join(el)


