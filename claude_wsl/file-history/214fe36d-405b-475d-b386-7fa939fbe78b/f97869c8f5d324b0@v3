"""flip 파라미터 스윕 보고서 — sweep_flip_results.json → body-only HTML(아티팩트).
사용: python3 make_sweep_report.py  → report/backtest_flip_sweep.artifact.html

차트: ① Δ히트맵 스몰멀티플(flip_max별, 행=컷오프·열=일수, 다이버징+직접라벨)
     ② top10 순위 바(부트스트랩 95% CI whisker, 281 기준선)
     ③ d1·x1 컷오프 붕괴 곡선. 모든 셀/바에 <title> 툴팁."""
import os, json, math, random, html

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
import bootstrap

OUT = os.path.join(ROOT, "report", "backtest_flip_sweep.artifact.html")
R = json.load(open(os.path.join(HERE, "sweep_flip_results.json"), encoding="utf-8"))
BASE = next(r for r in R if r["label"] == "281")

# 웜페이퍼(리포 톤) + 검증된 다이버징 폴 (#2E7D32/#C25744, 중립 회색)
PAPER, INK, ACCENT, GRID = "#F0EEE6", "#211D18", "#CC785C", "#D9D3C7"
MUTE, CARD = "#6B5E54", "#FBFAF6"
POS, NEG, NEUT = "#2E7D32", "#C25744", "#EDE8DD"
esc = html.escape

RULE = "square"     # 헤드라인 지표: square 배분 주간평균 (기존 최고 causal 규칙)
DAYS = [1, 2, 3, 5]
CUTS = [("09:30", "~09:30"), ("10:00", "~10:00"), ("12:00", "~12:00"), (None, "종일")]
MAXS = [(1, "1회"), (2, "2회"), (3, "3회"), (99, "무제한")]


def get(days, cut, mx):
    for r in R:
        if r["days"] == days and r["cutoff"] == cut and r["max"] == mx:
            return r
    return None


def paired(cfg_label, rule=RULE, B=5000, seed=42):
    """주별 paired Δ(cfg−281) 부트스트랩."""
    w1 = next(x for x in R if x["label"] == cfg_label)["weekly"][rule]
    w0 = BASE["weekly"][rule]
    d = [a - b for a, b in zip(w1, w0)]
    n = len(d); rng = random.Random(seed)
    means = sorted(sum(d[rng.randrange(n)] for _ in range(n)) / n for _ in range(B))
    return dict(mean=sum(d) / n * 100, lo=means[int(B*.025)] * 100, hi=means[int(B*.975)] * 100,
                p_pos=sum(1 for m in means if m > 0) / B, n_weeks=sum(1 for x in d if abs(x) > 1e-12))


# ── ① Δ 히트맵 스몰멀티플 ────────────────────────────────────────
def heatmap():
    cw, ch, gap = 66, 36, 2
    labL, labT = 56, 22
    fw = labL + 4 * cw + 8
    fh = labT + 4 * ch + 26
    b0 = BASE["rules_mean"][RULE]
    facets = []
    for mx, mlab in MAXS:
        el = [f'<svg viewBox="0 0 {fw} {fh}" width="{fw}" font-family="ui-sans-serif,system-ui,sans-serif">']
        el.append(f'<text x="{labL}" y="13" font-size="11.5" font-weight="800" fill="{INK}">최대 {mlab}</text>')
        for j, d in enumerate(DAYS):
            el.append(f'<text x="{labL+j*cw+cw/2:.0f}" y="{labT+4*ch+16}" font-size="10" fill="{MUTE}" text-anchor="middle">{d}일</text>')
        for i, (cut, clab) in enumerate(CUTS):
            el.append(f'<text x="{labL-6}" y="{labT+i*ch+ch/2+3:.0f}" font-size="10" fill="{MUTE}" text-anchor="end">{clab}</text>')
            for j, d in enumerate(DAYS):
                r = get(d, cut, mx)
                dv = r["rules_mean"][RULE] - b0
                if abs(dv) < 0.03:
                    fill, alpha = NEUT, 1.0
                else:
                    fill = POS if dv > 0 else NEG
                    alpha = 0.18 + min(1.0, abs(dv) / 0.45) * 0.72
                x, y = labL + j * cw, labT + i * ch
                tip = f"{r['label']} · {RULE} {r['rules_mean'][RULE]:+.3f}%/주 (281 대비 {dv:+.3f}%p) · 플립율 {r['flip_rate']:.1f}%"
                el.append(f'<g><title>{esc(tip)}</title>'
                          f'<rect x="{x}" y="{y}" width="{cw-gap}" height="{ch-gap}" rx="4" fill="{fill}" fill-opacity="{alpha:.2f}"/>'
                          f'<text x="{x+(cw-gap)/2:.0f}" y="{y+ch/2+3:.0f}" font-size="10.5" font-weight="700" '
                          f'fill="{INK}" text-anchor="middle">{dv:+.2f}</text></g>')
        el.append('</svg>')
        facets.append("".join(el))
    return '<div class="facets">' + "".join(f'<div class="facet">{f}</div>' for f in facets) + '</div>'


# ── ② top10 순위 바 + CI ─────────────────────────────────────────
def ranking():
    ranked = sorted(R, key=lambda r: -r["rules_mean"][RULE])[:10]
    if BASE not in ranked:
        ranked.append(BASE)
    stats = []
    for r in ranked:
        st = bootstrap.analyze(r["weekly"][RULE])
        stats.append((r, st))
    lo = min(min(0.0, s["ci_lo"]) for _, s in stats) - 0.15
    hi = max(s["ci_hi"] for _, s in stats) + 0.15
    W, rowh, labW, padR = 860, 30, 128, 14
    pw = W - labW - padR
    H = len(stats) * rowh + 34
    X = lambda v: labW + pw * (v - lo) / (hi - lo)
    b0 = BASE["rules_mean"][RULE]
    el = [f'<svg viewBox="0 0 {W} {H}" width="100%" style="max-width:{W}px" font-family="ui-sans-serif,system-ui,sans-serif">']
    for tv in [0.0, 0.5, 1.0, 1.5]:
        if lo <= tv <= hi:
            el.append(f'<line x1="{X(tv):.0f}" y1="8" x2="{X(tv):.0f}" y2="{H-24}" stroke="{GRID}" stroke-width="1"/>')
            el.append(f'<text x="{X(tv):.0f}" y="{H-10}" font-size="10" fill="{MUTE}" text-anchor="middle">{tv:+.1f}%</text>')
    el.append(f'<line x1="{X(b0):.0f}" y1="8" x2="{X(b0):.0f}" y2="{H-24}" stroke="{ACCENT}" stroke-width="1.6" stroke-dasharray="4 3"/>')
    el.append(f'<text x="{X(b0)+4:.0f}" y="18" font-size="10" font-weight="700" fill="{ACCENT}">281 기준 {b0:+.2f}%</text>')
    for i, (r, s) in enumerate(stats):
        y = 24 + i * rowh
        isbase = r["label"] == "281"
        col = MUTE if isbase else (POS if s["obs_mean"] >= b0 else NEG)
        name = "281 (기준)" if isbase else r["label"]
        tip = (f"{name} · 평균 {s['obs_mean']:+.3f}%/주 · 95% CI [{s['ci_lo']:+.2f}, {s['ci_hi']:+.2f}] · "
               f"P(>0) {s['prob_pos']*100:.0f}%" + ("" if isbase else f" · 플립율 {r['flip_rate']:.1f}%"))
        el.append(f'<g><title>{esc(tip)}</title>')
        el.append(f'<text x="{labW-8}" y="{y+4}" font-size="11" font-weight="{700 if isbase else 600}" fill="{INK}" text-anchor="end">{esc(name)}</text>')
        x0, x1v = X(min(0, s["obs_mean"])), X(max(0, s["obs_mean"]))
        el.append(f'<rect x="{X(0):.0f}" y="{y-7}" width="{max(1, X(s["obs_mean"])-X(0)):.0f}" height="14" rx="4" fill="{col}" fill-opacity="{0.5 if isbase else 0.85}"/>')
        el.append(f'<line x1="{X(s["ci_lo"]):.0f}" y1="{y}" x2="{X(s["ci_hi"]):.0f}" y2="{y}" stroke="{INK}" stroke-width="1.2" opacity="0.55"/>')
        for cx in (s["ci_lo"], s["ci_hi"]):
            el.append(f'<line x1="{X(cx):.0f}" y1="{y-4}" x2="{X(cx):.0f}" y2="{y+4}" stroke="{INK}" stroke-width="1.2" opacity="0.55"/>')
        el.append(f'<text x="{X(s["ci_hi"])+6:.0f}" y="{y+4}" font-size="10.5" font-weight="700" fill="{INK}">{s["obs_mean"]:+.2f}%</text>')
        el.append('</g>')
    el.append('</svg>')
    return "".join(el)


# ── ③ 미세 컷오프 곡선 (09:10~10:00, 5분 단위, d1·x1) ────────────
FINE = None
def _fine():
    global FINE
    if FINE is None:
        p = os.path.join(HERE, "sweep_flip_fine.json")
        FINE = json.load(open(p, encoding="utf-8")) if os.path.exists(p) else []
    return FINE


def decay():
    pts = [(r["cutoff"], r) for r in _fine()]
    b0 = BASE["rules_mean"][RULE]
    W, H, padL, padB, padT = 860, 250, 52, 44, 18
    pw, ph = W - padL - 18, H - padT - padB
    vals = [r["rules_mean"][RULE] for _, r in pts] + [b0]
    lo, hi = min(vals) - 0.1, max(vals) + 0.14
    X = lambda i: padL + pw * (i + 0.5) / len(pts)
    Y = lambda v: padT + ph * (hi - v) / (hi - lo)
    el = [f'<svg viewBox="0 0 {W} {H}" width="100%" style="max-width:{W}px" font-family="ui-sans-serif,system-ui,sans-serif">']
    # 고원(09:15~09:30) 배경 밴드
    i15 = next(i for i, (c, _) in enumerate(pts) if c == "09:15")
    i30 = next(i for i, (c, _) in enumerate(pts) if c == "09:30")
    el.append(f'<rect x="{X(i15)-14:.0f}" y="{padT}" width="{X(i30)-X(i15)+28:.0f}" height="{ph}" fill="{POS}" fill-opacity="0.07"/>')
    el.append(f'<text x="{(X(i15)+X(i30))/2:.0f}" y="{padT+13}" font-size="10" font-weight="700" fill="{POS}" text-anchor="middle">이기는 고원 09:15~09:30</text>')
    for tv in (0.6, 0.8, 1.0):
        if lo <= tv <= hi:
            el.append(f'<line x1="{padL}" y1="{Y(tv):.0f}" x2="{W-18}" y2="{Y(tv):.0f}" stroke="{GRID}" stroke-width="1"/>')
            el.append(f'<text x="{padL-6}" y="{Y(tv)+3:.0f}" font-size="10" fill="{MUTE}" text-anchor="end">{tv:+.1f}%</text>')
    el.append(f'<line x1="{padL}" y1="{Y(b0):.0f}" x2="{W-18}" y2="{Y(b0):.0f}" stroke="{ACCENT}" stroke-width="1.4" stroke-dasharray="4 3"/>')
    el.append(f'<text x="{W-20}" y="{Y(b0)-5:.0f}" font-size="10" font-weight="700" fill="{ACCENT}" text-anchor="end">281 {b0:+.2f}%</text>')
    path = " ".join(f'{"M" if i==0 else "L"} {X(i):.0f} {Y(r["rules_mean"][RULE]):.0f}' for i, (_, r) in enumerate(pts))
    el.append(f'<path d="{path}" fill="none" stroke="{INK}" stroke-width="2"/>')
    peak = max(range(len(pts)), key=lambda i: pts[i][1]["rules_mean"][RULE])
    for i, (lab, r) in enumerate(pts):
        v = r["rules_mean"][RULE]
        col = POS if v >= b0 else NEG
        tip = (f"~{lab} · square {v:+.3f}%/주 · quartic {r['rules_mean']['quartic']:+.3f}% · "
               f"종목-주 {r['sw_mean']:+.3f}% · 플립율 {r['flip_rate']:.1f}%")
        rr = 6 if i == peak else 4.5
        el.append(f'<g><title>{esc(tip)}</title>'
                  f'<circle cx="{X(i):.0f}" cy="{Y(v):.0f}" r="{rr}" fill="{col}" stroke="{CARD}" stroke-width="2"/></g>')
        if i in (0, i15, i30, peak, len(pts) - 1) or lab in ("09:20", "09:40", "09:50"):
            el.append(f'<text x="{X(i):.0f}" y="{Y(v)-11:.0f}" font-size="10.5" font-weight="700" fill="{INK}" text-anchor="middle">{v:+.2f}%</text>')
        el.append(f'<text x="{X(i):.0f}" y="{H-16}" font-size="10" fill="{MUTE}" text-anchor="middle">{lab}</text>')
        el.append(f'<text x="{X(i):.0f}" y="{H-4}" font-size="9" fill="{MUTE}" text-anchor="middle" opacity="0.8">{r["flip_rate"]:.0f}%</text>')
    el.append(f'<text x="{padL-38}" y="{H-4}" font-size="9" fill="{MUTE}">플립율</text>')
    el.append('</svg>')
    return "".join(el)


# ── 표: top12 + 최악3 ───────────────────────────────────────────
def table():
    ranked = sorted((r for r in R if r["label"] != "281"), key=lambda r: -r["rules_mean"][RULE])
    rows = []
    def row(r, cls=""):
        dv = r["rules_mean"][RULE] - BASE["rules_mean"][RULE]
        col = "pos" if dv > 0.01 else ("neg" if dv < -0.01 else "")
        return (f'<tr class="{cls}"><td><b>{esc(r["label"])}</b></td>'
                f'<td class="num">{r["rules_mean"]["equal"]:+.2f}%</td>'
                f'<td class="num">{r["rules_mean"]["linear"]:+.2f}%</td>'
                f'<td class="num"><b>{r["rules_mean"]["square"]:+.2f}%</b></td>'
                f'<td class="num">{r["rules_mean"]["quartic"]:+.2f}%</td>'
                f'<td class="num">{r["sw_mean"]:+.2f}%</td>'
                f'<td class="num {col}">{dv:+.2f}%p</td>'
                f'<td class="num sub">{r["flip_rate"]:.1f}%</td></tr>')
    rows.append(row(dict(BASE, label="281 (기준·플립 없음)"), "basehl"))
    for r in ranked[:12]:
        rows.append(row(r))
    rows.append('<tr class="ellip"><td colspan="8">… (전체 65설정: sweep_flip_results.json)</td></tr>')
    for r in ranked[-3:]:
        rows.append(row(r, "dim"))
    return "".join(rows)


def build():
    best = max(R, key=lambda r: r["rules_mean"][RULE])
    b0 = BASE["rules_mean"][RULE]
    pd = paired(best["label"])
    st_best = bootstrap.analyze(best["weekly"][RULE])
    st_base = bootstrap.analyze(BASE["weekly"][RULE])
    nconf = len(R) - 1

    return f"""<title>flip 파라미터 스윕 — 개장 25분의 발견</title>
