"""리버설밴드 미세 컷오프(09:05~10:30) 곡선 리포트.
사용: python3 make_band_fine_report.py → report/backtest_band_fine.html"""
import os, json, html

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
OUT = os.path.join(ROOT, "report", "backtest_band_fine.html")
R = json.load(open(os.path.join(HERE, "sweep_band_fine_results.json"), encoding="utf-8"))
BASE = next(r for r in R if r["label"] == "281"); B0 = BASE["square_mean"]
CUTS = sorted({r["cut"] for r in R if r["cut"]})

PAPER, INK, ACC, GRID = "#F0EEE6", "#211D18", "#CC785C", "#D9D3C7"
MUTE, CARD, POS, NEG = "#6B5E54", "#FBFAF6", "#2E7D32", "#C2493C"
esc = html.escape
g1 = lambda c: next(r for r in R if r["cut"] == c and r["max"] == 1)


def curve():
    pts = [(c, g1(c)) for c in CUTS]
    W, H, padL, padT, padB = 900, 300, 50, 20, 56
    pw, ph = W - padL - 18, H - padT - padB
    vals = [r["square_mean"] for _, r in pts] + [B0]
    lo, hi = min(vals) - 0.12, max(vals) + 0.16
    X = lambda i: padL + pw * (i + 0.5) / len(pts)
    Y = lambda v: padT + ph * (hi - v) / (hi - lo)
    el = [f'<svg viewBox="0 0 {W} {H}" width="100%" style="max-width:{W}px" font-family="ui-sans-serif,system-ui,sans-serif">']
    i15 = CUTS.index("09:15"); i30 = CUTS.index("09:30")
    el.append(f'<rect x="{X(i15)-12:.0f}" y="{padT}" width="{X(i30)-X(i15)+24:.0f}" height="{ph}" fill="{POS}" fill-opacity="0.07"/>')
    el.append(f'<text x="{(X(i15)+X(i30))/2:.0f}" y="{padT+12}" font-size="10" font-weight="700" fill="{POS}" text-anchor="middle">고원 09:15~09:30</text>')
    for tv in (0.6, 0.8, 1.0):
        if lo <= tv <= hi:
            el.append(f'<line x1="{padL}" y1="{Y(tv):.0f}" x2="{W-18}" y2="{Y(tv):.0f}" stroke="{GRID}" stroke-width="1"/>')
            el.append(f'<text x="{padL-6}" y="{Y(tv)+3:.0f}" font-size="10" fill="{MUTE}" text-anchor="end">{tv:.1f}%</text>')
    el.append(f'<line x1="{padL}" y1="{Y(B0):.0f}" x2="{W-18}" y2="{Y(B0):.0f}" stroke="{ACC}" stroke-width="1.4" stroke-dasharray="4 3"/>')
    el.append(f'<text x="{W-20}" y="{Y(B0)-5:.0f}" font-size="10" font-weight="700" fill="{ACC}" text-anchor="end">281 {B0:+.2f}%</text>')
    path = " ".join(f'{"M" if i==0 else "L"} {X(i):.0f} {Y(r["square_mean"]):.0f}' for i, (_, r) in enumerate(pts))
    el.append(f'<path d="{path}" fill="none" stroke="{INK}" stroke-width="2"/>')
    peak = max(range(len(pts)), key=lambda i: pts[i][1]["square_mean"])
    for i, (c, r) in enumerate(pts):
        v = r["square_mean"]; col = POS if v >= B0 else NEG; rr = 6 if i == peak else 4
        tip = f'~{c} · square {v:+.3f}%/주 · P={r["p_pos"]*100:.0f}% · 플립율 {r["flip_rate"]:.0f}%'
        el.append(f'<g><title>{esc(tip)}</title><circle cx="{X(i):.0f}" cy="{Y(v):.0f}" r="{rr}" fill="{col}" stroke="{CARD}" stroke-width="2"/></g>')
        if i in (0, peak, len(pts) - 1) or c in ("09:15", "09:40", "10:05", "10:25"):
            el.append(f'<text x="{X(i):.0f}" y="{Y(v)-11:.0f}" font-size="10" font-weight="700" fill="{INK}" text-anchor="middle">{v:.2f}</text>')
        el.append(f'<text x="{X(i):.0f}" y="{H-30}" font-size="9" fill="{MUTE}" text-anchor="middle" transform="rotate(-45 {X(i):.0f} {H-30})">{c}</text>')
    el.append('</svg>')
    return "".join(el)


def build():
    best = max((g1(c) for c in CUTS), key=lambda r: r["square_mean"])
    return f"""<!DOCTYPE html><html lang="ko"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>리버설밴드 미세 컷오프 09:05~10:30</title>
<style>*{{box-sizing:border-box}}body{{margin:0;background:{PAPER};color:{INK};font-family:ui-sans-serif,system-ui,"Apple SD Gothic Neo",sans-serif;line-height:1.6}}
.wrap{{max-width:960px;margin:0 auto;padding:34px 20px 60px}}
.eyebrow{{font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:{ACC};font-weight:800;margin:0 0 8px}}
h1{{font-size:24px;margin:0 0 6px;font-weight:800}} .sub{{color:{MUTE};font-size:13.5px;margin:0 0 16px;max-width:76ch}}
.card{{background:{CARD};border:1px solid {GRID};border-radius:12px;padding:16px 18px;margin:12px 0}}
.scrollx{{overflow-x:auto}} h2{{font-size:18px;margin:30px 0 8px;font-weight:800}}
ul{{margin:6px 0;padding-left:20px}} li{{margin:5px 0}} b.g{{color:{POS}}}
.foot{{margin-top:26px;font-size:12px;color:{MUTE};border-top:1px solid {GRID};padding-top:14px}} .foot code{{background:#e7e1d5;padding:1px 5px;border-radius:4px}}
</style></head><body><div class="wrap">
<p class="eyebrow">리버설밴드(fable4) · 미세 컷오프 · 09:05~10:30 5분 단위</p>
<h1>월요일 전환 컷오프를 5분씩 · square 주간평균</h1>
<p class="sub">flip_max=1 고정, 컷오프만 09:05→10:30 5분씩. 부트스트랩(SEED=42·B=5,000). 베이스 281 {B0:+.2f}%.
최고 <b class="g">~{best["cut"]} {best["square_mean"]:+.2f}%</b> (P={best["p_pos"]*100:.0f}%).</p>
<div class="card scrollx">{curve()}</div>
<h2>해석</h2>
<div class="card"><ul>
<li><b>09:05~09:10은 플립 0% (=281)</b> — 창이 너무 짧아 첫 진입 후 전환이 물리적으로 안 뜸.</li>
<li><b>09:15부터 상승, 09:30에서 정점(+0.99%).</b> 09:35~09:55는 절벽(+0.62~0.75, 281 부근으로 하락).</li>
<li><b>10:05·10:25에서 소폭 반등</b>하나 09:30 고원엔 못 미침 — 부차적 봉우리(노이즈 가능).</li>
<li>결론: 리버설밴드도 <b>‘개장 25분(~09:30)’</b>이 최적. 이전 트레일 플립·다른 스윕과 동일. ⚠️ 인샘플 부트스트랩만(WF 전, 선택편향 유의).</li>
</ul></div>
<div class="foot">엔진 <code>engine_fable4</code>(cross_freeze·flip_max 1) · 데이터 CREON 5분봉 255주 · 부트스트랩 SEED=42·B=5,000·square · 재현 <code>back_test/sweep_band_fine.py</code>.</div>
</div></body></html>"""


if __name__ == "__main__":
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    open(OUT, "w", encoding="utf-8").write(build())
    print("wrote", OUT)
