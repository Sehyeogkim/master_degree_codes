  flip_cutoff_hm: "09:30"  # 월 09:30까지만 전환 허용 ("개장 25분")
  flip_max: 1              # 주당 최대 1회
  # tp_reset_pct 미지정 = 사다리 리셋 없음(rnone) — 리셋 계열은 전 변형 기각

