"""자본배분 6규칙 (causal) — 라이브 리포트 렌더용.

신호 = 직전주 변동율 크기 |chg| (토요일 선정 때 확정 → look-ahead 없음).
back_test/allocation.py 실험판과 동일한 규칙·정규화. 각 규칙:
  (signals, returns) → 정규화 가중치 w(Σw=1) → 포트수익률 Σ w·r.
포트폴리오는 무레버(자본 100% 투입), 주중 종목간 재배분 없음(토요일 1회 배정).
"""
import math

# 표시 순서 = 리포트 열 순서
RULE_LABELS = [("equal", "균등"), ("linear", "신호¹"), ("square", "신호²"),
               ("quartic", "신호⁴"), ("sigmoid", "시그모이드"), ("softmax", "softmax")]


def _pos(x):
    return x if x > 0 else 0.0


def _norm(w):
    s = sum(w)
    return [x / s for x in w] if s > 0 else [1.0 / len(w)] * len(w)   # 전부 0 → 균등 폴백


def _z(sig):
    n = len(sig); m = sum(sig) / n
    sd = math.sqrt(sum((x - m) ** 2 for x in sig) / n) or 1.0
    return [(x - m) / sd for x in sig]


def weights(key, sig):
    """규칙 key + 신호벡터 → 정규화 가중치."""
    if key == "equal":
        return _norm([1.0] * len(sig))
    if key == "linear":
        return _norm([_pos(x) for x in sig])
    if key == "square":
        return _norm([_pos(x) ** 2 for x in sig])
    if key == "quartic":
        return _norm([_pos(x) ** 4 for x in sig])
    z = _z(sig)
    if key == "sigmoid":
        return _norm([1.0 / (1.0 + math.exp(-t)) for t in z])
    if key == "softmax":
        return _norm([math.exp(t) for t in z])
    raise ValueError(f"unknown allocation rule: {key}")


def dashboard(signals, returns, capital):
    """signals=[|chg|...], returns=[rᵢ(소수)...], capital(원) →
    규칙별 [{key,label,w,slices,port,val}] (표시 순서)."""
    out = []
    for key, label in RULE_LABELS:
        w = weights(key, signals)
        slices = [wi * capital for wi in w]
        port = sum(wi * ri for wi, ri in zip(w, returns))
        out.append(dict(key=key, label=label, w=w, slices=slices,
                        port=port, val=capital * (1.0 + port)))
    return out
