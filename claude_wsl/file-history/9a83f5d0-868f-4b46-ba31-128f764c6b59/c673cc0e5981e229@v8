DEFAULT_CAPITAL = 50_000_000                                                           # ₩5,000만 (배분 기준자본)
# 순차 램프(배정액 크기) — 밝기 단조감소. 각 셀에 ₩라벨 직접표기로 대비 확보.
_RAMP = [(0xF4, 0xEF, 0xE7), (0xE7, 0xC9, 0xB4), (0xD8, 0x9A, 0x78), (0xCC, 0x78, 0x5C), (0xA8, 0x56, 0x38)]


def _ramp(t):
    """t∈[0,1] → (hex, luma). luma로 셀 글자색(밝/어둠) 결정."""
    t = max(0.0, min(1.0, t)); x = t * (len(_RAMP) - 1); i = int(x); f = x - i
    a = _RAMP[i]; b = _RAMP[min(i + 1, len(_RAMP) - 1)]
    r, g, bl = (int(round(a[k] + (b[k] - a[k]) * f)) for k in range(3))
    return f"#{r:02x}{g:02x}{bl:02x}", 0.299 * r + 0.587 * g + 0.114 * bl


def _won(x):
    return f"{x/1e4:,.0f}만"


def alloc_dashboard(pstocks, capital=DEFAULT_CAPITAL):
    """포트폴리오 종목들(≥2)에 대해 6규칙 배분 대시보드 HTML(리더보드+매트릭스) 반환.
    pstocks: [{code,name,dir,chg,r}]  (chg=직전주변동%, r=주간수익률 소수)."""
    sig = [abs(p["chg"]) for p in pstocks]
    ret = [p["r"] for p in pstocks]
    rules = allocation.dashboard(sig, ret, capital)
    maxslice = max((s for ru in rules for s in ru["slices"]), default=1.0) or 1.0

    def col(x):
        return POS if x >= 0 else NEG

    # ① 리더보드 (현재 평가액 순)
    ranked = sorted(rules, key=lambda r: -r["val"])
    maxabs = max((abs(r["port"]) for r in rules), default=1.0) or 1.0
    lb = []
    for i, r in enumerate(ranked):
        c = col(r["port"]); w = abs(r["port"]) / maxabs * 100
        lb.append(
            f"<div class='lbrow'><span class='rk'>{['①','②','③','④','⑤','⑥'][i]}</span>"
            f"<span class='rl'>{r['label']}</span>"
            f"<span class='rv'>{capital/1e4:,.0f}만 → <b>{r['val']/1e4:,.0f}만</b></span>"
            f"<span class='bar'><span style='width:{w:.0f}%;background:{c}'></span></span>"
            f"<span class='rp' style='color:{c}'>{r['port']*100:+.2f}%</span></div>")
    leaderboard = ("<div class='dcard'><div class='dcap'>규칙 리더보드 — "
                   f"{capital/1e4:,.0f}만원이 지금 얼마?</div>" + "".join(lb) + "</div>")

    # ② 배분 매트릭스 (행=종목, 열=규칙, 셀=배정액)
    head = "<th class='lft'>종목</th><th>직전주<br>변동</th><th>rᵢ<br>(주수익)</th>" + \
           "".join(f"<th>{r['label']}</th>" for r in rules)
    body = []
    for si, st in enumerate(pstocks):
        cells = []
        for ru in rules:
            sl = ru["slices"][si]; bg, luma = _ramp(sl / maxslice)
            fg = "#fff" if luma < 140 else INK
            cells.append(f"<td style='background:{bg};color:{fg};font-weight:600'>{_won(sl)}</td>")
        body.append(
            f"<tr><td class='lft'><b>{_esc(st['name'])}</b> "
            f"<span style='color:{MUTED};font-size:11px'>{st['code']}·{st['dir']}</span></td>"
            f"<td style='color:{MUTED}'>{st['chg']:+.0f}%</td>"
            f"<td style='color:{col(st['r'])};font-weight:800'>{st['r']*100:+.2f}%</td>"
            + "".join(cells) + "</tr>")
    foot_p = f"<td class='lft' style='font-weight:800'>포트 수익률</td><td></td><td></td>" + \
        "".join(f"<td style='font-weight:800;color:{col(r['port'])}'>{r['port']*100:+.2f}%</td>" for r in rules)
    foot_v = f"<td class='lft' style='color:{MUTED}'>현재 평가액</td><td></td><td></td>" + \
        "".join(f"<td style='color:{MUTED};font-size:12px'>{r['val']/1e4:,.0f}만</td>" for r in rules)
    matrix = (f"<div class='dcard'><div class='dcap'>배분 매트릭스 — 종목별 ‘처음 넣은 돈’"
              f"<span class='dnote'>진할수록 많이 배정 · 셀=₩ · {capital/1e4:,.0f}만 기준</span></div>"
              f"<div class='dwrap'><table class='mx'><thead><tr>{head}</tr></thead>"
              f"<tbody>{''.join(body)}</tbody>"
              f"<tfoot><tr>{foot_p}</tr><tr>{foot_v}</tr></tfoot></table></div></div>")
    return ("<div class='dsec'>① 규칙 리더보드</div>" + leaderboard +
            "<div class='dsec'>② 배분 매트릭스 (핵심)</div>" + matrix)


def week_chart(bars, events, ctx, reentry):
    cs = [Candle(b.hm, b.o, b.h, b.l, b.c) for b in bars]
    n = len(cs); W = max(940, n * 8 + 90); H = 430
    ch = Chart(cs, width=W, height=H, pad_left=62, pad_right=22)
    F0 = ctx["F0"]
    for L in ctx["longL"]:
        ch.hline(L, C_UPPER, f"진입기준선 {L:,.0f}", dash="6 5", width=1.2, opacity=0.8)
    ch.hline(F0, C_F0, f"F0 {F0:,.0f}", dash="", width=1.4, opacity=0.7)
    for e in events:
        live = "데이터 종료" in e.reason
        if e.kind == "ENTRY":
            is_re = id(e) in reentry
            ch.marker(e.idx, e.price, "E", (TRAIL if is_re else C_ENTRY),
                      arrow=("up" if e.direction > 0 else "down"),
                      note=("재진입" if is_re else "진입"), tip=f"{e.dt[11:16]} {e.reason}")
        else:
            ch.marker(e.idx, e.price, ("◆" if live else e.marker),
                      (ACCENT if live else (C_TP if e.marker == "T" else C_STOP)),
                      note=("현재가(미청산)" if live else e.note),
                      tip=f"{e.dt[11:16]} {e.reason} ({e.pnl:+,.0f})")
    svg = ch.svg()
    x0, y0, x1, y1 = ch._plot; step = (x1 - x0) / n
    ds = {}
    for i, b in enumerate(bars):
        ds.setdefault(b.day, i)
    extra = ""
    for d, si in ds.items():
        bx = x0 + step * si; wd = WD[datetime.date(*map(int, d.split("-"))).weekday()]
        if si > 0:
            extra += f'<line x1="{bx:.1f}" x2="{bx:.1f}" y1="{y0}" y2="{y1}" stroke="{MUTED}" stroke-dasharray="3 5" opacity="0.55"/>'
        extra += (f'<rect x="{bx+2:.1f}" y="{y0+2}" width="78" height="16" fill="{CODEBG}" rx="3"/>'
                  f'<text x="{bx+7:.1f}" y="{y0+14}" font-size="11" fill="{INK}" font-weight="700">{d[5:]} ({wd})</text>')
    extra += f'<text x="{x0+3}" y="{ch._y(F0)-3:.1f}" font-size="10.5" fill="{C_F0}" font-weight="700">F0 {F0:,.0f}</text>'
    for L in ctx["longL"]:
        extra += f'<text x="{x0+3}" y="{ch._y(L)-3:.1f}" font-size="10.5" fill="{C_UPPER}" font-weight="700">기준선 {L:,.0f}</text>'
    return svg.replace("</svg>", extra + "</svg>").replace('class="chart"', f'style="width:{W}px;height:{H}px;display:block"')


