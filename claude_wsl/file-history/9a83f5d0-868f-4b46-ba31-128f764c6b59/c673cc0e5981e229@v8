BG, INK, ACCENT, BORDER, MUTED, CODEBG, POS, NEG, TRAIL = (
    "#F0EEE6", "#1A1A1A", "#CC785C", "#D4C5B0", "#6B5E54", "#E6E0D4", "#2E7D32", "#C25744", "#2E7D32")
