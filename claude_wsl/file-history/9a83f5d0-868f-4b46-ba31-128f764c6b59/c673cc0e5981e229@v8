<li>{entry_txt}</li><li>{tp_txt}</li>
<li><b>손절</b>: 없음(281). {pos_txt}</li>
<li><b>현재 평가수익률: <span class="{'g' if wr>=0 else 'r'}">{wr:+.2f}%</span></b> ({stamp})</li></ul></div>"""


def _esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


def _mini_week_chart(days, w=180, h=84):
    """직전주 월~금 일봉 미니 캔들 SVG. days=[{d,o,h,l,c}]. 선정보고서 표 셀용."""
    days = [x for x in days if x]
    if not days:
        return f'<span style="color:{MUTED};font-size:11px">데이터 없음</span>'
    lo = min(x["l"] for x in days); hi = max(x["h"] for x in days)
    rng = (hi - lo) or 1.0
    n = len(days); padx, padt, padb = 6, 6, 15
    ph = h - padt - padb
    step = (w - 2 * padx) / n
    cw = min(step * 0.55, 14)

    def Y(v):
        return padt + (hi - v) / rng * ph

    body = ""
    for i, x in enumerate(days):
        cx = padx + step * i + step / 2
        col = POS if x["c"] >= x["o"] else NEG
        body += f'<line x1="{cx:.1f}" x2="{cx:.1f}" y1="{Y(x["h"]):.1f}" y2="{Y(x["l"]):.1f}" stroke="{col}" stroke-width="1"/>'
        yo, yc = Y(x["o"]), Y(x["c"])
        top = min(yo, yc); bh = max(abs(yo - yc), 1.6)
        body += f'<rect x="{cx-cw/2:.1f}" y="{top:.1f}" width="{cw:.1f}" height="{bh:.1f}" fill="{col}"/>'
        try:
            wd = WD[datetime.date(*map(int, x["d"].split("-"))).weekday()]
        except Exception:
            wd = ""
        body += f'<text x="{cx:.1f}" y="{h-4}" font-size="9" fill="{MUTED}" text-anchor="middle">{wd}</text>'
    return (f'<svg width="{w}" height="{h}" viewBox="0 0 {w} {h}" '
            f'style="display:block;margin:auto">{body}</svg>')


