def build_report(sections, meta):
    """섹션 리스트 → 완성 HTML 문자열. meta 토글로 live/historical·single/multi를 렌더."""
    stamp = meta["stamp"]
    live = meta.get("live", False)
    intro = meta.get("intro", True)
    refresh = meta.get("refresh")
    doctitle = meta.get("doctitle", "LIVE 281 · 이번 주")
    h1 = meta.get("h1", f"🔴 LIVE — 281 이번 주 진행 ({stamp})")
    subtitle = meta.get("subtitle", "선정 지난주 → 이번 주 5분봉 281 가동 · TradingView-Screener + yfinance · F0=지난주 금종가")

    # 포트폴리오 배분 대시보드 (≥2종목일 때) — 종목별 배정액을 칩으로도 표기.
    capital = meta.get("capital", DEFAULT_CAPITAL)
    pstocks = [dict(code=s["code"], name=s["name"],
                    dir=("롱" if ([e for e in s["events"] if e.kind == "ENTRY"] and
                                 [e for e in s["events"] if e.kind == "ENTRY"][0].direction > 0)
                         else ("숏" if [e for e in s["events"] if e.kind == "ENTRY"] else "—")),
                    chg=s["sel"].get("chg", 0.0), r=s["ctx"]["weekly_return"]) for s in sections]
    alloc_html = ""; slice_by = {}
    if meta.get("alloc", True) and len(pstocks) >= 2:
        alloc_html = alloc_dashboard(pstocks, capital)
        _rules = allocation.dashboard([abs(p["chg"]) for p in pstocks],
                                      [p["r"] for p in pstocks], capital)
        for si, p in enumerate(pstocks):
            slice_by[p["code"]] = [(ru["label"], ru["slices"][si]) for ru in _rules]

    sections_html = ""; summ = []
    for s in sections:
        code, name, sel = s["code"], s["name"], s["sel"]
        bars, events, ctx, src = s["bars"], s["events"], s["ctx"], s["source"]
        ents = [e for e in events if e.kind == "ENTRY"]
        reentry = set(id(e) for e in ents[1:])
        wr = ctx["weekly_return"] * 100
        d = "롱" if (ents and ents[0].direction > 0) else ("숏" if ents else "—")
        nbar = len(bars)
        summ.append((code, name, sel.get("chg", 0.0), wr, d, src, nbar))
        label = s.get("label", f"{name} ({code})")
        chipbar = ""
        if code in slice_by:
            chips = "".join(f"<span class='chip'>{lb} <b>{_won(sl)}</b></span>" for lb, sl in slice_by[code])
            chipbar = f"<div class='chipbar'>규칙별 배정액: {chips}</div>"
        sections_html += f"""<section class="wk"><h2>{label} <span class="wr {'g' if wr>=0 else 'r'}">평가 {wr:+.2f}%</span></h2>
{chipbar}<p class="hint">← 옆으로 스크롤 (월~현재) → · 데이터 {src} ({nbar}봉)</p><div class="ch">{week_chart(bars, events, ctx, reentry)}</div>
{narrative(name, code, sel, ctx, events, stamp)}</section>"""

    intro_html = ""
    if intro:
        srow = "".join(f"<tr><td>{n} ({c})</td><td>{ch:+.1f}%</td><td>{d}</td><td class='{'g' if w>=0 else 'r'}'>{w:+.2f}%</td><td style='font-size:11.5px;color:{MUTED}'>{src} {nb}봉</td></tr>"
                       for c, n, ch, w, d, src, nb in summ)
        note = ("⚠️ 진행 중 — 미청산은 평가손익(현재가), 금 15:15 실제청산. 거래대금 Σ(종가×거래량) 근사."
                if live else "거래대금 Σ(종가×거래량) 근사. 금 15:15 강제청산으로만 손실 실현(한 주 제한).")
        intro_html = f"""{legend_block()}
<div class="intro">📋 <b>선정 규칙</b>: ① 시총 5,000억↑ → ② 주간변동율 상승 Top20 → ③ 거래대금 Top5.
<table style="margin-top:8px"><thead><tr><th>선정 종목</th><th>지난주 변동율</th><th>방향</th><th>현재 평가</th><th>데이터</th></tr></thead><tbody>{srow}</tbody></table>
<p style="margin:8px 2px 0;color:{MUTED};font-size:12.5px">{note}</p></div>
"""
    else:
        intro_html = f"{legend_block()}\n"

    refresh_meta = f'<meta http-equiv="refresh" content="{refresh}">' if refresh else ""

    return f"""<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">{refresh_meta}
<title>{doctitle}</title><style>
*{{box-sizing:border-box}}body{{margin:0;background:{BG};color:#2D2D2D;font-family:-apple-system,"Apple SD Gothic Neo",sans-serif;line-height:1.6}}
main{{max-width:1000px;margin:0 auto;padding:38px 20px 90px}}h1{{font-size:24px;margin:0 0 4px}}.sub{{color:{MUTED};font-size:14px;margin:0 0 14px}}
h2{{font-size:18px;margin:8px 0;padding-left:10px;border-left:4px solid {ACCENT}}}h2 .wr{{float:right}}
.wk{{background:#fff;border:1px solid {BORDER};border-radius:14px;padding:14px 16px;margin:16px 0}}.hint{{color:{ACCENT};font-size:12.5px;font-weight:600;margin:2px 0 6px}}
.ch{{overflow-x:auto;border:1px solid {BORDER};border-radius:8px}}.ch svg{{display:block}}
.logic{{background:{CODEBG};border-radius:10px;padding:14px 17px;margin:10px 0}}.logic h3{{color:{ACCENT};margin:0 0 8px;font-size:15px}}.logic li{{font-size:13.8px;margin:5px 0}}
.g{{color:{POS};font-weight:700}}.r{{color:{NEG};font-weight:700}}.intro{{background:#fff;border:2px solid {ACCENT};border-radius:12px;padding:15px 18px;margin:12px 0;font-size:14px}}
table{{width:100%;border-collapse:collapse;font-size:13.5px}}th,td{{border-bottom:1px solid {BORDER};padding:7px 9px;text-align:right}}th:first-child,td:first-child{{text-align:left}}th{{background:{CODEBG}}}
.dsec{{font-size:13px;font-weight:800;color:{ACCENT};letter-spacing:.03em;margin:22px 0 6px}}
.dcard{{background:#fff;border:1px solid {BORDER};border-radius:14px;padding:14px 16px;margin:10px 0}}
.dcap{{font-weight:800;font-size:15px;margin-bottom:8px}}.dcap .dnote{{float:right;font-weight:500;font-size:11.5px;color:{MUTED}}}
.lbrow{{display:flex;align-items:center;gap:12px;padding:9px 4px;border-bottom:1px solid {CODEBG}}}
.lbrow .rk{{width:22px;color:{MUTED};font-weight:700}}.lbrow .rl{{width:88px;font-weight:700}}
.lbrow .rv{{width:150px;color:{MUTED};font-size:12.5px}}.lbrow .rv b{{color:{INK}}}
.lbrow .bar{{flex:1;height:9px;background:{CODEBG};border-radius:5px;overflow:hidden}}
.lbrow .bar span{{display:block;height:100%}}.lbrow .rp{{width:74px;text-align:right;font-weight:800}}
.dwrap{{overflow-x:auto}}table.mx{{border-collapse:collapse;font-size:13px;min-width:760px;width:100%}}
table.mx th,table.mx td{{border-bottom:1px solid #EDE6D8;padding:8px 6px;text-align:center;white-space:nowrap}}
table.mx thead th{{background:{CODEBG};font-size:12px;color:{INK}}}table.mx .lft{{text-align:left}}
table.mx tfoot td{{border-top:2px solid {BORDER};background:#FAF7F1}}
.chipbar{{font-size:12px;color:{MUTED};margin:4px 0 2px}}
.chip{{display:inline-block;background:#F4EFE7;border:1px solid #E6DcCB;border-radius:20px;padding:2px 9px;margin:2px 3px 2px 0}}</style></head><body><main>
<h1>{h1}</h1><p class="sub">{subtitle}</p>
{intro_html}{alloc_html}{sections_html}</main></body></html>"""
