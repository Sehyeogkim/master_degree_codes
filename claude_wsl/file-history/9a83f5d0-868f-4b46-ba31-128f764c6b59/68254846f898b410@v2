# -*- coding: utf-8 -*-
"""255주 × 7규칙 주간수익률/누적 시계열 인터랙티브 HTML 생성."""
import json

SP = "/tmp/claude-1000/-home-jeff-bullet281/9a83f5d0-868f-4b46-ba31-128f764c6b59/scratchpad"
D = json.load(open(f"{SP}/series.json"))

COLORS = {"equal": "#0072B2", "linear": "#56B4E9", "square": "#009E73",
          "quartic": "#E69F00", "sigmoid": "#CC79A7", "softmax": "#D55E00",
          "lookahead_gap4": "#8A7E70"}

data_js = json.dumps(D, ensure_ascii=False)
colors_js = json.dumps(COLORS)

HTML = """<style>
:root{--bg:#F0EEE6;--card:#fff;--ink:#1A1A1A;--muted:#6B5E54;--acc:#CC785C;--border:#D9D2C6;--grid:#EDE7DB}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);
font-family:-apple-system,"Apple SD Gothic Neo",sans-serif;line-height:1.5}
main{max-width:1060px;margin:0 auto;padding:30px 18px 80px}
h1{font-size:22px;margin:0 0 4px}.sub{color:var(--muted);font-size:13px;margin:0 0 16px}
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:14px 16px;margin:14px 0;position:relative}
.ctitle{font-weight:800;font-size:15px;margin-bottom:2px}.cnote{color:var(--muted);font-size:12px;margin-bottom:8px}
.legend{display:flex;flex-wrap:wrap;gap:6px 10px;margin:4px 0 10px}
.lg{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border:1px solid var(--border);
border-radius:20px;font-size:12.5px;cursor:pointer;user-select:none;background:#FAF7F1}
.lg.off{opacity:.38;text-decoration:line-through}
.sw{width:14px;height:3px;border-radius:2px;display:inline-block}
.sw.dash{background:none!important;border-top:3px dotted}
.chartwrap{position:relative;overflow-x:auto}
svg{display:block}.tip{position:absolute;pointer-events:none;background:#1A1A1A;color:#fff;font-size:11.5px;
padding:7px 9px;border-radius:7px;white-space:nowrap;opacity:0;transition:opacity .08s;z-index:5;max-width:230px}
.tip b{color:#F0EEE6}.trow{display:flex;justify-content:space-between;gap:10px}
table{width:100%;border-collapse:collapse;font-size:13px;margin-top:4px}
th,td{border-bottom:1px solid var(--border);padding:6px 8px;text-align:right}th:first-child,td:first-child{text-align:left}
th{background:#E6E0D4}.tag{font-size:10.5px;color:var(--muted)}
.g{color:#2E7D32;font-weight:700}.r{color:#C25744;font-weight:700}
.hint{font-size:11.5px;color:var(--muted);margin-top:6px}
</style>
<main>
<h1>281 자본배분 — 방법별 주간수익률 (255주)</h1>
<p class="sub">2021-05 ~ 2026-06 · 원자=주 · rᵢ=net(수수료·세금·슬리피지) · 배분규칙별 색상 · 범례 클릭=토글 · 마우스 올리면 값</p>

<div class="card">
  <div class="ctitle">① 주별 포트폴리오 수익률 <span class="tag">(방법별 Σwᵢrᵢ · %/주)</span></div>
  <div class="cnote">고변동 노이즈 — 방법들이 거의 겹칩니다. look-ahead는 스케일 압도라 기본 OFF(점선).</div>
  <div class="legend" id="leg"></div>
  <div class="chartwrap"><div id="c1"></div><div class="tip" id="t1"></div></div>
  <div class="hint">Y축 = 그 주 포트폴리오 net 수익률(%). 0선 회색.</div>
</div>

<div class="card">
  <div class="ctitle">② 누적 복리수익률 <span class="tag">(같은 배분을 255주 굴렸을 때 · %)</span></div>
  <div class="cnote">여기서 진짜 이야기가 나옵니다 — <b>평균은 square가 최고지만 누적은 equal이 압도</b>(변동성 드래그: 집중할수록 분산↑→복리 손해). look-ahead=+8,955%는 오프스케일이라 제외.</div>
  <div class="chartwrap"><div id="c2"></div><div class="tip" id="t2"></div></div>
  <div class="hint">Y축 = 누적 복리수익률(%). 6 causal 규칙만(비교 가능 스케일).</div>
