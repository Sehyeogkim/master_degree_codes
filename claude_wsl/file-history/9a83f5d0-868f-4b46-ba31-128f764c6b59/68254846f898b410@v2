<script>
const DATA=__DATA__, COLORS=__COLORS__;
const CAUSAL=DATA.order.filter(k=>DATA.series[k].causal);
const vis=new Set(DATA.order); vis.delete('lookahead_gap4');  // look-ahead 기본 OFF
const W=980,H=360,padL=54,padR=112,padT=16,padB=34;
const n=DATA.n, weeks=DATA.weeks;
function xs(i){return padL+i*(W-padL-padR)/(n-1);}
function niceDom(keys,vk){let mn=1e9,mx=-1e9;keys.forEach(k=>{if(!vis.has(k))return;DATA.series[k][vk].forEach(v=>{if(v<mn)mn=v;if(v>mx)mx=v;});});
 if(mn===1e9){mn=0;mx=1;} const pad=(mx-mn)*0.06||1; mn-=pad;mx+=pad; return [mn,mx];}
function ys(v,dom,h){const[a,b]=dom;return padT+(b-v)/(b-a)*(h-padT-padB);}
function yticks(dom){const[a,b]=dom;const step=niceStep((b-a)/5);const out=[];let t=Math.ceil(a/step)*step;
 for(;t<=b+1e-9;t+=step)out.push(+t.toFixed(6));return out;}
function niceStep(x){const p=Math.pow(10,Math.floor(Math.log10(x)));const f=x/p;return (f<1.5?1:f<3?2:f<7?5:10)*p;}

function draw(cid,vk,keys,H_){
 const dom=niceDom(keys,vk);
 let g=`<svg width="${W}" height="${H_}" viewBox="0 0 ${W} ${H_}">`;
 g+=`<rect x="${padL}" y="${padT}" width="${W-padL-padR}" height="${H_-padT-padB}" fill="#fff"/>`;
 // y grid + labels
 yticks(dom).forEach(t=>{const y=ys(t,dom,H_);
   g+=`<line x1="${padL}" x2="${W-padR}" y1="${y.toFixed(1)}" y2="${y.toFixed(1)}" stroke="${t===0?'#B7AC9B':'#EDE7DB'}" stroke-width="${t===0?1.3:1}"/>`;
   g+=`<text x="${padL-7}" y="${(y+3).toFixed(1)}" text-anchor="end" font-size="10.5" fill="#98908a">${t}%</text>`;});
 // x ticks: year starts
 let py=null;
 weeks.forEach((w,i)=>{const y=w.slice(0,4); if(y!==py){py=y;const x=xs(i);
   g+=`<line x1="${x.toFixed(1)}" x2="${x.toFixed(1)}" y1="${padT}" y2="${H_-padB}" stroke="#F1EBDF"/>`;
   g+=`<text x="${x.toFixed(1)}" y="${H_-padB+15}" text-anchor="middle" font-size="10.5" fill="#98908a">${y}</text>`;}});
 // series
 keys.forEach(k=>{if(!vis.has(k))return;const arr=DATA.series[k][vk];
   let d='';for(let i=0;i<n;i++){d+=(i?'L':'M')+xs(i).toFixed(1)+' '+ys(arr[i],dom,H_).toFixed(1)+' ';}
   const dash=k==='lookahead_gap4'?'stroke-dasharray="2 3"':'';const wdt=k==='equal'?2.3:1.7;
   g+=`<path d="${d}" fill="none" stroke="${COLORS[k]}" stroke-width="${wdt}" ${dash} opacity="0.9"/>`;
   // 끝점 직접 라벨
   const lx=xs(n-1),ly=ys(arr[n-1],dom,H_);
   g+=`<text x="${(lx+5).toFixed(1)}" y="${(ly+3).toFixed(1)}" font-size="10.5" font-weight="700" fill="${COLORS[k]}">${DATA.series[k].label.split(' ')[0]}</text>`;});
 g+=`<line id="${cid}-cx" x1="0" x2="0" y1="${padT}" y2="${H_-padB}" stroke="#1A1A1A" stroke-width="1" opacity="0"/>`;
 g+=`<g id="${cid}-dots"></g></svg>`;
 document.getElementById(cid).innerHTML=g;
 const svg=document.getElementById(cid).firstChild;
 svg._dom=dom; svg._vk=vk; svg._keys=keys; svg._H=H_;
 svg.addEventListener('mousemove',ev=>hover(ev,cid,svg));
 svg.addEventListener('mouseleave',()=>{document.getElementById(cid+'-cx').setAttribute('opacity','0');
   document.getElementById(cid+'-dots').innerHTML='';document.getElementById(tipId(cid)).style.opacity=0;});
}
function tipId(cid){return cid==='c1'?'t1':'t2';}
function hover(ev,cid,svg){const r=svg.getBoundingClientRect();const sx=(ev.clientX-r.left)*(W/r.width);
 let i=Math.round((sx-padL)/((W-padL-padR)/(n-1)));i=Math.max(0,Math.min(n-1,i));
 const x=xs(i);const cx=document.getElementById(cid+'-cx');cx.setAttribute('x1',x);cx.setAttribute('x2',x);cx.setAttribute('opacity','0.35');
 let dots='',rows='';const dom=svg._dom,vk=svg._vk,keys=svg._keys,H_=svg._H;
 keys.filter(k=>vis.has(k)).sort((a,b)=>DATA.series[b][vk][i]-DATA.series[a][vk][i]).forEach(k=>{
   const v=DATA.series[k][vk][i];const y=ys(v,dom,H_);
   dots+=`<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="3.5" fill="${COLORS[k]}" stroke="#fff" stroke-width="1"/>`;
   rows+=`<div class="trow"><span><span class="sw" style="background:${COLORS[k]};display:inline-block;width:10px"></span> ${DATA.series[k].label.split(' ')[0]}</span><b>${v.toFixed(2)}%</b></div>`;});
 document.getElementById(cid+'-dots').innerHTML=dots;
 const tip=document.getElementById(tipId(cid));tip.innerHTML=`<b>${weeks[i]}</b> (${i+1}/${n}주)${rows}`;
 const wrap=svg.parentElement.getBoundingClientRect();let tx=ev.clientX-wrap.left+14;
 if(tx>wrap.width-150)tx=ev.clientX-wrap.left-150;
 tip.style.left=tx+'px';tip.style.top=(ev.clientY-wrap.top+10)+'px';tip.style.opacity=1;
}
function legend(){document.getElementById('leg').innerHTML=DATA.order.map(k=>{
 const off=vis.has(k)?'':'off';const dash=k==='lookahead_gap4'?'dash':'';
 return `<span class="lg ${off}" data-k="${k}"><span class="sw ${dash}" style="${dash?'border-color:':'background:'}${COLORS[k]}"></span>${DATA.series[k].label}</span>`;}).join('');
 document.querySelectorAll('.lg').forEach(el=>el.onclick=()=>{const k=el.dataset.k;
   if(vis.has(k))vis.delete(k);else vis.add(k);render();});}
function table(){document.getElementById('tb').innerHTML=DATA.order.map(k=>{const s=DATA.series[k];
 return `<tr><td><span class="sw" style="background:${COLORS[k]};display:inline-block;width:12px;margin-right:5px"></span>${s.label}</td>
 <td>${s.mean.toFixed(3)}%</td><td class="${s.final>=0?'g':'r'}">${s.final.toLocaleString()}%</td>
 <td class="tag">${s.causal?'causal':'look-ahead'}</td></tr>`;}).join('');}
function render(){draw('c1','r',DATA.order,H);draw('c2','cum',CAUSAL,H);legend();}
render();table();
</script>"""

html = HTML.replace("__DATA__", data_js).replace("__COLORS__", colors_js)
out = f"{SP}/timeseries_255w.html"
open(out, "w", encoding="utf-8").write(html)
print("wrote", out, len(html), "bytes")
