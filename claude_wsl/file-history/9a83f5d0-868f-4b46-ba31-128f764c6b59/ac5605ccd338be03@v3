"""screeners — 종목 선정(스크리닝) 로직 레지스트리.

각 스크리너는 이 폴더의 모듈 1개. 표준 인터페이스 select_stocks(...) 를 노출한다.
config.yaml 의 `screener:` 필드가 어떤 스크리너를 쓸지 이름으로 지목한다.

새 선정 로직 = 이 폴더에 모듈 하나 추가 (기존 모듈은 불변). engines/ 의 매매엔진 plug-in과 대칭.
  · 파라미터만 바뀌면(시총컷·TopN·direction) → config.yaml 숫자만, 코드 0
  · 선정 '로직'이 바뀌면(RSI·섹터·신고가 등) → 여기에 momentum_v2 같은 새 모듈 추가

등록된 스크리너:
  momentum_v1  시총≥cap_min → 직전주 변동율 Top → 거래대금 Top (direction up=롱 / down=숏)

※ 폴더명이 'selectors'가 아닌 이유: 파이썬 표준 라이브러리에 selectors 모듈이 있어
   sys.path 앞에 놓으면 이를 가려(shadow) asyncio 등이 깨진다. 그래서 screeners로 명명.
"""
import importlib, os, sys

HERE = os.path.dirname(os.path.abspath(__file__))
PIPELINE = os.path.dirname(HERE)
for _p in (PIPELINE, HERE):
    if _p not in sys.path:
        sys.path.insert(0, _p)


def get_screener(name):
    """name → 그 스크리너 모듈 (select_stocks/resolve_names 보유)."""
    return importlib.import_module(f"screeners.{name}")


# 종목명 조회는 스크리너 무관 공통 유틸 → 기본 구현(momentum_v1) 재노출
from screeners.momentum_v1 import resolve_names  # noqa: E402,F401
