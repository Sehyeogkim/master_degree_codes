#!/bin/bash
# Wait for the meshing batch to reach a terminal state (all 384 done, or the
# batch process gone), then email the user. Covers the failure exit too --
# a watcher that only matches success stays silent through a crash.
cd /home/jeff/project/65_final_0723
PY=/home/jeff/miniconda3/envs/ansys_new/bin/python
while true; do
  D=$(ls fluid_0723/case_*/meshing/mesh-complete/mesh-complete.mesh.vtu 2>/dev/null | wc -l)
  [ "$D" -ge 384 ] && { $PY bin/notify_email.py "[lumen meshing] 완료 384/384" "$($PY bin/notify_email.py --status >/dev/null 2>&1; echo)"; break; }
  pgrep -f "mesh_all_g015[.]py" >/dev/null || break
  sleep 60
done
$PY bin/notify_email.py --status
