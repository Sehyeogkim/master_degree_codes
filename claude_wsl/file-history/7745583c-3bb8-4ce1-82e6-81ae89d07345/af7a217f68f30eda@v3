import json, numpy as np, pandas as pd
ROOT = "/home/jeff/project/65_final_0723"
par = pd.read_csv(f"{ROOT}/pre_data/parameter.csv")

def series(case, pid, t0=401, t1=500):
    d = f"{ROOT}/fluid_0723/case_{case}/pulsatile_1d_hyperemia/result"
    P = []
    for t in range(t0, t1 + 1):
        seg = json.load(open(f"{d}/result_{t}.json"))["segments"][0]["double_point_data"]["pressure"]
        P.append(seg[pid])
    return np.array(P) / 1333.22

for case in [55, 8, 100]:
    prox = series(case, 0)
    dist = series(case, 30)
    ffr = dist.mean() / prox.mean()
    sbp = par.loc[case, "SBP"]; pp = par.loc[case, "PP"]
    dos = par.loc[case, "DOS"]; ll = par.loc[case, "lesion_length"]
    print("case %d: SBP=%.0f PP=%.0f DOS=%.3f LL=%.2f" % (case, sbp, pp, dos, ll))
    print("   prox pt0 : min=%7.2f max=%7.2f mean=%7.2f mmHg" % (prox.min(), prox.max(), prox.mean()))
    print("   dist pt30: min=%7.2f max=%7.2f mean=%7.2f mmHg  n_neg=%d/100" % (dist.min(), dist.max(), dist.mean(), int((dist < 0).sum())))
    print("   FFR = %.4f" % ffr)
