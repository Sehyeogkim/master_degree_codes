#!/usr/bin/env python
"""Retry the 9 TIMEOUT/heavy LAP cases with COARSER mesh size + longer cap.
Geometry is fine on these; they just exceeded the 10-min cap at 0.055-0.06.
Coarser size => far fewer elements => fits the budget. Appends to the shared
progress jsonl. Worker skips if solid_LAP_<c>.msh already exists."""
import json, time, subprocess, threading
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, as_completed

HERE = Path(__file__).resolve().parent
PY = "/home/jeff/miniconda3/envs/ansys_new/bin/python"
NPROC = 5
WORKERS = 4
CAP = 1200  # 20 min per rung

CASES = [30, 40, 176, 189, 196, 223, 246, 379, 443]
# coarse ladder: bigger size first, then coarser + algo variation
RUNGS = [(0.065, 5, 10), (0.075, 6, 10), (0.08, 5, 1)]

LAPDIR = HERE / "LAP_mesh"
LOGDIR = LAPDIR / "logs"; LOGDIR.mkdir(parents=True, exist_ok=True)
PROG = LAPDIR / "batch_0728_progress.jsonl"          # shared append
STATUS = LAPDIR / "batch_retry_coarse_status.json"
MARKER = LAPDIR / "batch_retry_coarse.marker"

_lock = threading.Lock()
counts = {"total": len(CASES), "done": 0, "failed": 0, "timeout": 0, "skipped": 0, "running": 0}
start_time = time.time()


def msh_path(c):
    return LAPDIR / f"solid_LAP_{c}.msh"


def write_status():
    with _lock:
        s = dict(counts); s["start_time"] = start_time; s["elapsed"] = round(time.time() - start_time, 1)
    try:
        tmp = STATUS.with_suffix(".tmp"); tmp.write_text(json.dumps(s, indent=2)); tmp.replace(STATUS)
    except OSError as e:
        print(f"[warn] write_status failed: {e}", flush=True)


def record(entry):
    entry["ts"] = time.time()
    with _lock:
        with open(PROG, "a") as f:
            f.write(json.dumps(entry) + "\n")
        st = entry.get("status")
        if st in counts: counts[st] += 1
    write_status()


def attempt(c, size, a2, a3, tag):
    logf = LOGDIR / f"case{c}_{tag}.log"
    try:
        with open(logf, "w") as lf:
            p = subprocess.run([PY, "mesh_one_LAP.py", str(c), str(NPROC), str(size), str(a2), str(a3)],
                               cwd=str(HERE), stdout=lf, stderr=subprocess.STDOUT, timeout=CAP)
        for line in reversed(logf.read_text(errors="replace").splitlines()):
            if line.startswith("STATUS "):
                return json.loads(line[len("STATUS "):])
        return {"status": "failed", "error": f"no STATUS line (exit {p.returncode})"}
    except subprocess.TimeoutExpired:
        return {"status": "timeout"}
    except Exception as e:
        return {"status": "failed", "error": f"{type(e).__name__}: {e}"}


def run_case(c):
    if msh_path(c).exists():
        record({"case": c, "status": "skipped"}); return {"case": c, "status": "skipped"}
    with _lock: counts["running"] += 1
    write_status()
    entry = {"case": c}
    try:
        for i, (size, a2, a3) in enumerate(RUNGS):
            st = attempt(c, size, a2, a3, f"coarse{i+1}")
            st.update({"mesh_size": size, "algo2d": a2, "algo3d": a3, "rung": i + 1})
            entry.update(st)
            if st.get("status") == "done": break
            err = str(st.get("error", ""))
            if st.get("status") == "failed" and any(k in err for k in ("STEP", "overlapping facets", "Invalid boundary")):
                break
    finally:
        with _lock: counts["running"] -= 1
    record(entry)
    return entry


def main():
    if MARKER.exists(): MARKER.unlink()
    write_status()
    print(f"[LAP-retry-coarse] {len(CASES)} cases {CASES}, ladder={RUNGS}, cap {CAP}s", flush=True)
    with ThreadPoolExecutor(max_workers=WORKERS) as ex:
        futs = [ex.submit(run_case, c) for c in CASES]
        for fut in as_completed(futs):
            e = fut.result()
            print(f"[case {e.get('case')}] {e.get('status')} rung={e.get('rung')} size={e.get('mesh_size')} "
                  f"elem={e.get('num_elements')} min_q={e.get('min_quality')} neg={e.get('neg_jacobian')} "
                  f"{e.get('seconds')}s {str(e.get('error',''))[:60]}", flush=True)
    MARKER.write_text("DONE\n"); write_status()
    print("[LAP-retry-coarse] COMPLETE", flush=True)


if __name__ == "__main__":
    main()
