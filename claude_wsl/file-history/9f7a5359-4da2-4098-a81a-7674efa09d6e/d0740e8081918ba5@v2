"""
Generate LAP geometry for the mesh-FAILED cases, using the combo:
    lumen  = GUIDELINE   (utils.lumen_guideline)
    solid  = GUIDELINE   (utils.solid_guideline)
    lipid  = lipid_main  (utils.lipid_main)
    fc / fc_offset = usual (utils.fc)

Output: geo_0728_LAP/case_<id>/{lumen,solid,fc,fc_offset,lipid}.{ipt,stp}
Run on Windows with Autodesk Inventor OPEN.  (COM automation.)

Tip: to try ONE case first, set  CASES = CASES[:1]  below.
Cases with a twisted lipid are handled MANUALLY in Inventor afterwards.
"""
import os
import traceback
from datetime import datetime
import pandas as pd

from main_CAD import CAD_instance_from_idx
from utils.lumen_guideline import lumen_step
from utils.solid_guideline import solid_step
from utils.fc import fc_step, fc_offset_step
from utils.lipid_main import lipid_step

CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
CASE_CSV = os.path.join(CURRENT_DIR, "parameter_0728.csv")
SAVE_DIR = os.path.join(CURRENT_DIR, "geo_0728_LAP")
LOG_PATH = os.path.join(CURRENT_DIR, "failed_0728_LAP.log")

# LAP mesh-failed geometry cases, id<500 (46 boolean/surface defects + 291,427)
CASES = [3, 8, 13, 23, 48, 49, 52, 54, 66, 69, 115, 121, 126, 135, 148, 164, 171,
         183, 194, 205, 211, 222, 239, 240, 280, 290, 291, 301, 312, 331, 338, 345,
         351, 355, 357, 360, 401, 403, 413, 414, 416, 426, 427, 429, 453, 484, 486, 494]


def generate_case(model, case_dir):
    """Full LAP pipeline with guideline lumen+solid, lipid_main, usual fc."""
    lumen_ipt = os.path.join(case_dir, "lumen.ipt")
    # 1) lumen (guideline, rail-based -> more robust)
    model.lumen_path = lumen_step(model, case_dir)
    if not os.path.exists(lumen_ipt):
        raise FileNotFoundError("lumen.ipt not created")
    # 2) solid (guideline)
    model.solid_path = solid_step(model, case_dir)
    # 3) fc (lumen offset by fc_av_th)
    model.fc_path = fc_step(model, case_dir, lumen_ipt)
    # 4) fc_offset (lumen offset by d_fc_ca + fc_av_th)  -> also used by CP later
    model.fc_offset_path = fc_offset_step(model, case_dir, lumen_ipt)
    # 5) lipid (lipid_main; twist cases fixed manually afterwards)
    model.lipid_path = lipid_step(model, case_dir)


if __name__ == "__main__":
    os.makedirs(SAVE_DIR, exist_ok=True)
    print(f"generating {len(CASES)} cases -> {SAVE_DIR}")
    still_failed = []
    for i in CASES:
        try:
            model = CAD_instance_from_idx(i, CASE_CSV)
            model.connect_to_inventor()
            case_dir = os.path.join(SAVE_DIR, f"case_{i}")
            os.makedirs(case_dir, exist_ok=True)
            generate_case(model, case_dir)
            print(f"Case {i} completed (guideline lumen+solid, lipid_main)")
            model.inv.Documents.CloseAll(True)
        except Exception as e:
            print(f"Error case {i}: {e}")
            traceback.print_exc()
            try:
                model.inv.Documents.CloseAll(True)
            except Exception:
                pass
            still_failed.append(i)
        print(f"SO FAR FAILED: {still_failed}")

    with open(LOG_PATH, "w") as f:
        f.write(f"# {datetime.now().isoformat(timespec='seconds')}\n")
        f.write(f"# guideline lumen+solid, lipid_main, fc; {len(CASES)} cases\n")
        f.write(f"# still failed ({len(still_failed)}): "
                f"{','.join(map(str, still_failed)) if still_failed else 'none'}\n")
    print("ALL COMPLETE")
    print(f"still failed: {still_failed}")
