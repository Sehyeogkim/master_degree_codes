def load_bars(code):
    out=[]
    with open(f"{BASE}/bars/{code}_5m.csv") as f:
        for row in csv.DictReader(f):
            out.append((row["datetime"], float(row["open"]), float(row["high"]),
                        float(row["low"]), float(row["close"])))
    return out

def candle_svg(code, F0, entries, exits):
    bars = load_bars(code)
    n=len(bars); cw=8; gap=2; padL=54; padR=14; padT=14; padB=26
    W=padL+padR+n*(cw+gap); H=230
    los=[b[3] for b in bars]; his=[b[2] for b in bars]
    lo=min(los+[F0]); hi=max(his+[F0]); rng=hi-lo or 1
    def y(p): return padT+(hi-p)/rng*(H-padT-padB)
    def x(i): return padL+i*(cw+gap)
    parts=[f"<svg width='{W}' height='{H}' viewBox='0 0 {W} {H}' xmlns='http://www.w3.org/2000/svg' style='font:11px sans-serif'>"]
    parts.append(f"<rect width='{W}' height='{H}' fill='#fff'/>")
    # y grid (3)
    for k in range(4):
        p=lo+rng*k/3; yy=y(p)
        parts.append(f"<line x1='{padL}' y1='{yy:.1f}' x2='{W-padR}' y2='{yy:.1f}' stroke='#eef' />")
        parts.append(f"<text x='{padL-6}' y='{yy+3:.1f}' text-anchor='end' fill='#98908a'>{p:,.0f}</text>")
    # F0 line
    yf=y(F0)
    parts.append(f"<line x1='{padL}' y1='{yf:.1f}' x2='{W-padR}' y2='{yf:.1f}' stroke='{C_F0}' stroke-dasharray='5 3' />")
    parts.append(f"<text x='{W-padR}' y='{yf-4:.1f}' text-anchor='end' fill='{C_F0}' font-weight='700'>F0 {F0:,.0f}</text>")
    # day separators
    prevday=None
    for i,b in enumerate(bars):
        day=b[0][:10]
        if prevday and day!=prevday:
            parts.append(f"<line x1='{x(i)-gap/2:.1f}' y1='{padT}' x2='{x(i)-gap/2:.1f}' y2='{H-padB}' stroke='#d9d2c6' stroke-dasharray='2 3'/>")
            parts.append(f"<text x='{x(i)+2:.1f}' y='{H-padB+16}' fill='#98908a'>{day[5:]}</text>")
        elif i==0:
            parts.append(f"<text x='{x(i):.1f}' y='{H-padB+16}' fill='#98908a'>{day[5:]}</text>")
        prevday=day
    # candles
    for i,b in enumerate(bars):
        dt,o,h,l,c=b; up=c>=o; col=C_UP if up else C_DOWN
        cx=x(i)+cw/2
        parts.append(f"<line x1='{cx:.1f}' y1='{y(h):.1f}' x2='{cx:.1f}' y2='{y(l):.1f}' stroke='{col}' stroke-width='1'/>")
        yo,yc=y(o),y(c); top=min(yo,yc); hgt=max(abs(yo-yc),1)
        parts.append(f"<rect x='{x(i):.1f}' y='{top:.1f}' width='{cw}' height='{hgt:.1f}' fill='{col}'/>")
    # markers
    dtidx={b[0]:i for i,b in enumerate(bars)}
    def marker(dt, price, letter, color):
        i=dtidx.get(dt)
        if i is None: return
        cx=x(i)+cw/2; yy=y(price)
        parts.append(f"<circle cx='{cx:.1f}' cy='{yy:.1f}' r='7' fill='{color}' />")
        parts.append(f"<text x='{cx:.1f}' y='{yy+3:.1f}' text-anchor='middle' fill='#fff' font-weight='800' font-size='9'>{letter}</text>")
    for e in entries: marker(e["dt"], e["price"], "E", C_E)
    for e in exits:
        m=e.get("marker","T"); marker(e["dt"], e["price"], m, C_S if m=="S" else C_T)
    parts.append("</svg>")
    return "".join(parts)

