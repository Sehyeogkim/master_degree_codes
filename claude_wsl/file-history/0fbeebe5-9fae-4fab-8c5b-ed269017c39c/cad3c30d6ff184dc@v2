RAMP = [(0xF4,0xEF,0xE7),(0xE7,0xC9,0xB4),(0xD8,0x9A,0x78),(0xCC,0x78,0x5C),(0xA8,0x56,0x38)]

def lerp(a,b,t): return a+(b-a)*t
def ramp(t):
    t=max(0.0,min(1.0,t)); x=t*(len(RAMP)-1); i=int(x); f=x-i
    a=RAMP[i]; b=RAMP[min(i+1,len(RAMP)-1)]
    r,g,bl=(int(round(lerp(a[k],b[k],f))) for k in range(3))
    return f"#{r:02x}{g:02x}{bl:02x}", (0.299*r+0.587*g+0.114*bl)  # hex, luma
