def week_chart(bars, events, ctx, reentry):
    cs = [Candle(b.hm, b.o, b.h, b.l, b.c) for b in bars]
    n = len(cs); W = max(940, n * 8 + 90); H = 430
    ch = Chart(cs, width=W, height=H, pad_left=62, pad_right=22)
    F0 = ctx["F0"]
    for L in ctx["longL"]:
        ch.hline(L, C_UPPER, f"진입기준선 {L:,.0f}", dash="6 5", width=1.2, opacity=0.8)
    ch.hline(F0, C_F0, f"F0 {F0:,.0f}", dash="", width=1.4, opacity=0.7)
    for e in events:
        live = "데이터 종료" in e.reason
        if e.kind == "ENTRY":
            is_re = id(e) in reentry
            ch.marker(e.idx, e.price, "E", (TRAIL if is_re else C_ENTRY),
                      arrow=("up" if e.direction > 0 else "down"),
                      note=("재진입" if is_re else "진입"), tip=f"{e.dt[11:16]} {e.reason}")
        else:
            ch.marker(e.idx, e.price, ("◆" if live else e.marker),
                      (ACCENT if live else (C_TP if e.marker == "T" else C_STOP)),
                      note=("현재가(미청산)" if live else e.note),
                      tip=f"{e.dt[11:16]} {e.reason} ({e.pnl:+,.0f})")
    svg = ch.svg()
    x0, y0, x1, y1 = ch._plot; step = (x1 - x0) / n
    ds = {}
    for i, b in enumerate(bars):
        ds.setdefault(b.day, i)
    extra = ""
    for d, si in ds.items():
        bx = x0 + step * si; wd = WD[datetime.date(*map(int, d.split("-"))).weekday()]
        if si > 0:
            extra += f'<line x1="{bx:.1f}" x2="{bx:.1f}" y1="{y0}" y2="{y1}" stroke="{MUTED}" stroke-dasharray="3 5" opacity="0.55"/>'
        extra += (f'<rect x="{bx+2:.1f}" y="{y0+2}" width="78" height="16" fill="{CODEBG}" rx="3"/>'
                  f'<text x="{bx+7:.1f}" y="{y0+14}" font-size="11" fill="{INK}" font-weight="700">{d[5:]} ({wd})</text>')
    extra += f'<text x="{x0+3}" y="{ch._y(F0)-3:.1f}" font-size="10.5" fill="{C_F0}" font-weight="700">F0 {F0:,.0f}</text>'
    for L in ctx["longL"]:
        extra += f'<text x="{x0+3}" y="{ch._y(L)-3:.1f}" font-size="10.5" fill="{C_UPPER}" font-weight="700">기준선 {L:,.0f}</text>'
    return svg.replace("</svg>", extra + "</svg>").replace('class="chart"', f'style="width:{W}px;height:{H}px;display:block"')


def narrative(name, code, sel, ctx, events):
    fb = ctx["first_bar"]; wr = ctx["weekly_return"] * 100
    ents = [e for e in events if e.kind == "ENTRY"]
    tps = [e for e in events if e.kind == "EXIT" and e.marker == "T" and "데이터 종료" not in e.reason]
    live = [e for e in events if "데이터 종료" in e.reason]
    if ents:
        e0 = ents[0]; gap = e0.direction * (e0.price / ctx["F0"] - 1) * 100
        entry_txt = (f"<b>진입</b>: {e0.dt[5:16]} 종가 <b>{e0.price:,.0f}</b> 신고점 돌파 → "
                     f"{'롱' if e0.direction>0 else '숏'} (gap {gap:+.1f}%)"
                     + (f" · 재진입 {len(ents)-1}회" if len(ents) > 1 else ""))
    else:
        entry_txt = "<b>진입 없음</b>: 신고점 돌파 없어 관망."
    tp_txt = ("<b>익절</b>: " + ", ".join(f"{e.dt[5:16]} {e.note}({e.pnl:+,.0f})" for e in tps) + " 실현."
              if tps else "<b>익절</b>: 아직 +8% 게이트 미도달.")
    pos_txt = (f"<b>현재</b>: 미청산 보유(현재가 {live[0].price:,.0f}), 무손절 홀드→금 15:15 청산 예정. 평가 {wr:+.2f}%."
               if (ents and live) else (f"<b>현재</b>: 청산 완료 {wr:+.2f}%." if ents else "무포지션 0%."))
    return f"""<div class="logic"><h3>🧠 {name}({code})</h3><ul>
<li><b>선정</b>: 지난주 변동율 <b>{sel['chg']:+.1f}%</b>·거래대금 {sel['val']/1e8:,.0f}억·F0 {ctx['F0']:,.0f}. 첫봉 {fb.hm} {'양봉' if fb.bull else '음봉'}→base {'롱' if ctx['base']>0 else '숏'}·Case{ctx['case']}.</li>
<li>{entry_txt}</li><li>{tp_txt}</li>
<li><b>손절</b>: 없음(281). {pos_txt}</li>
<li><b>현재 평가수익률: <span class="{'g' if wr>=0 else 'r'}">{wr:+.2f}%</span></b> ({STAMP})</li></ul></div>"""


