number_of_variables 5  #P, Vx, Vy, Vz

    mesh_and_adjncy_vtu /home/jeff/40_1D_pratice/meshing/mesh-complete/mesh-complete.mesh.vtu 
    set_surface_id_vtp /home/jeff/40_1D_pratice/meshing/mesh-complete/walls_combined.vtp 1
    set_surface_id_vtp /home/jeff/40_1D_pratice/meshing/mesh-complete/mesh-surfaces/inlet.vtp 2
    set_surface_id_vtp /home/jeff/40_1D_pratice/meshing/mesh-complete/mesh-surfaces/outlet.vtp 3

    fluid_density 1.06
    fluid_viscosity 0.04
    initial_pressure 0
    initial_velocity 0.0001 0.0001 0.0001

    prescribed_velocities_vtp /home/jeff/40_1D_pratice/meshing/mesh-complete/mesh-surfaces/inlet.vtp
    pressure_vtp /home/jeff/40_1D_pratice/meshing/mesh-complete/mesh-surfaces/outlet.vtp 0.0
