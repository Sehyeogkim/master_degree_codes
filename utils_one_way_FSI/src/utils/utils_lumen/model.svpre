    bct_analytical_shape parabolic
    bct_period 1.0
    bct_point_number 2
    bct_fourier_mode_number 15

    bct_create /home/jeff/40_1D_pratice/meshing/mesh-complete/mesh-surfaces/inlet.vtp inflow.flow

    bct_merge_on

    bct_write_dat bct.dat
    bct_write_vtp bct.vtp

    write_geombc geombc.dat.1
    write_restart restart.0.1
    write_numstart 0
    